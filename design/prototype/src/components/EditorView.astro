<div
  x-show="activeView === 'editor'"
  class="flex-1 flex flex-col h-full overflow-hidden"
>
  <div
    class="flex-1 overflow-y-auto no-scrollbar"
    @click="handleEditorClick($event)"
    @mousemove="handleEditorMouseMove($event)"
    @mouseleave="hideBlockHandle()"
  >
    <div class="max-w-2xl w-full mx-auto px-8 py-8">
      <div class="space-y-4 pb-6">
        <input
          type="text"
          x-model="editorTitle"
          @input="syncEditorTitle()"
          placeholder="Untitled"
          class="w-full text-[30px] leading-[1.2] font-medium bg-transparent border-none outline-none text-foreground"
        />

        <div
          class="flex flex-wrap items-center gap-x-3 gap-y-1 pt-1"
          x-show="activeEntry"
        >
          <template x-if="activeEntry?.status">
            <span class="property inline-flex items-center gap-1">
              <span class="text-[12px] text-muted-foreground">Status</span>
              <span
                class="status-dot w-2 h-2 rounded-full shrink-0"
                :style="'background: var(--status-' + activeEntry.status + ')'"
              ></span>
              <span
                class="text-[12px] font-medium text-foreground capitalize"
                x-text="activeEntry.status"
              ></span>
            </span>
          </template>

          <template x-if="activeEntry?.priority">
            <span class="property inline-flex items-center gap-1">
              <span class="text-[12px] text-muted-foreground">Priority</span>
              <span
                class="text-[12px] font-medium text-foreground capitalize"
                x-text="activeEntry.priority"
              ></span>
            </span>
          </template>

          <template x-if="activeEntry?.due">
            <span class="property inline-flex items-center gap-1">
              <span class="text-[12px] text-muted-foreground">Due</span>
              <span
                class="text-[12px] font-medium text-foreground capitalize"
                x-text="activeEntry.due"
              ></span>
            </span>
          </template>

          <template x-if="activeEntry?.start && activeEntry?.end">
            <span class="property inline-flex items-center gap-1">
              <span class="text-[12px] text-muted-foreground">Timeline</span>
              <span
                class="text-[12px] font-medium text-foreground"
                x-text="activeEntry.start + ' → ' + activeEntry.end"
              ></span>
            </span>
          </template>

          <template x-if="activeEntry?.url">
            <span class="property inline-flex items-center gap-1 min-w-0">
              <span class="text-[12px] text-muted-foreground">URL</span>
              <span
                class="text-[12px] font-medium text-foreground truncate max-w-[200px]"
                x-text="activeEntry.url"
              ></span>
            </span>
          </template>

          <template x-if="activeEntry?.assignee">
            <span class="property inline-flex items-center gap-1">
              <span class="text-[12px] text-muted-foreground">Assignee</span>
              <span
                class="avatar-chip"
                x-text="(activeEntry.assignee || '?').slice(0, 2).toUpperCase()"
              ></span>
            </span>
          </template>

          <template x-if="activeEntry?.owner">
            <span class="property inline-flex items-center gap-1">
              <span class="text-[12px] text-muted-foreground">Owner</span>
              <span
                class="avatar-chip"
                x-text="(activeEntry.owner || '?').slice(0, 2).toUpperCase()"
              ></span>
            </span>
          </template>

          <template
            x-if="activeEntry?.tags && activeEntry.tags.length > 0"
          >
            <span class="property inline-flex items-center gap-1">
              <span class="text-[12px] text-muted-foreground">Tags</span>
              <template x-for="tag in activeEntry.tags" :key="tag">
                <span class="tag-pill inline-flex items-center px-2 py-0.5 text-[12px] text-foreground bg-secondary rounded-full" x-text="'#' + tag"></span>
              </template>
            </span>
          </template>
        </div>

        <div
          x-show="activeEditorSection === 'docs'"
          class="text-[14px] text-muted-foreground pt-1"
        >
          Documents (0)
        </div>
      </div>

      <div class="relative pt-6">
        <div
          id="block-handle"
          class="absolute -left-9 top-0 z-10 items-center gap-0.5"
          style="display: none"
        >
          <button
            @click="insertBlockAfterLine()"
            title="Add block below"
            class="w-6 h-6 flex items-center justify-center rounded-[6px] text-muted-foreground hover:bg-hover hover:text-foreground cursor-pointer"
          >
            <span class="text-[14px] leading-none">+</span>
          </button>
          <button
            title="Drag to reorder"
            class="w-6 h-6 flex items-center justify-center rounded-[6px] text-muted-foreground hover:bg-hover hover:text-foreground cursor-pointer"
          >
            <iconify-icon :icon="getIconName('drag')" class="w-3.5 h-3.5"></iconify-icon>
          </button>
        </div>
        <div
          id="editor-content-body"
          contenteditable="true"
          spellcheck="false"
          @input="syncEditorContent()"
          @keyup="handleEditorKeyUp($event)"
          @mouseup="handleSelectionChange($event)"
          class="prose-readable w-full bg-transparent border-none outline-none text-foreground"
        ></div>
      </div>
    </div>
  </div>
</div>
