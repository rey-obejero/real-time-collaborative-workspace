<div
  x-show="activeView === 'conversations'"
  class="flex-1 flex flex-col h-full overflow-hidden"
>
  <div class="flex flex-1 overflow-hidden">
    <div
      class="w-72 shrink-0 flex flex-col border-r border-border bg-background overflow-hidden"
    >
      <div class="h-14 px-4 flex items-center justify-between shrink-0">
        <span class="text-[14px] font-medium text-foreground">
          Conversations
        </span>
        <button
          @click="closeConversations()"
          class="w-7 h-7 flex items-center justify-center rounded-full hover:bg-secondary focus-ring"
          title="Close conversations"
        >
          <iconify-icon :icon="getIconName('x')" class="w-3.5 h-3.5"></iconify-icon>
        </button>
      </div>

      <div class="px-4 pb-3 shrink-0">
        <div class="flex items-center gap-1 p-1 bg-secondary rounded-full w-fit">
          <button
            @click="conversationFilter = 'all'"
            :class="conversationFilter === 'all' ? 'bg-foreground text-background' : 'text-muted-foreground hover:text-foreground'"
            class="px-3 py-1 text-[12px] font-medium rounded-full"
          >
            All
          </button>
          <button
            @click="conversationFilter = 'unread'"
            :class="conversationFilter === 'unread' ? 'bg-foreground text-background' : 'text-muted-foreground hover:text-foreground'"
            class="px-3 py-1 text-[12px] font-medium rounded-full"
          >
            Unread
          </button>
        </div>
      </div>

      <div class="flex-1 overflow-y-auto no-scrollbar">
        <template x-if="filteredDiscussions.length === 0">
          <div class="px-5 py-6">
            <p class="text-[12px] text-muted-foreground">
              No unread conversations.
            </p>
          </div>
        </template>
        <ul class="px-2 space-y-0.5">
          <template x-for="chat in filteredDiscussions" :key="chat.id">
            <li
              class="row-item cursor-pointer"
              :class="{ 'active': selectedDiscussionId === chat.id }"
              @click="selectedDiscussionId = chat.id"
            >
              <div class="px-3 py-2.5">
                <div class="flex items-center justify-between mb-1">
                  <span
                    class="text-[14px] font-medium leading-[1.5] text-foreground truncate"
                    x-text="chat.title"
                  ></span>
                  <span
                    x-show="chat.unread"
                    class="status-dot shrink-0 ml-2"
                    style="background: var(--foreground)"
                  ></span>
                </div>
                <div class="flex items-center justify-between gap-2">
                  <p
                    class="text-[12px] truncate leading-[1.5] text-muted-foreground"
                    x-text="chat.preview"
                  ></p>
                  <span
                    class="text-[12px] shrink-0 text-muted-foreground"
                    x-text="chat.time"
                  ></span>
                </div>
              </div>
            </li>
          </template>
        </ul>
      </div>
    </div>

    <div class="flex-1 flex flex-col overflow-hidden bg-background">
      <template x-if="selectedDiscussionId === null">
        <div class="flex-1 flex items-center justify-center">
          <p class="text-[14px] text-muted-foreground">
            Select a conversation to view.
          </p>
        </div>
      </template>

      <template x-if="selectedDiscussionId !== null">
        <div class="flex-1 flex flex-col overflow-hidden">
          <div
            class="h-14 px-6 flex items-center gap-2 shrink-0 border-b border-border"
          >
            <button
              @click="selectedDiscussionId = null"
              class="w-7 h-7 flex items-center justify-center rounded-full hover:bg-secondary focus-ring"
              title="Back to list"
            >
              <iconify-icon :icon="getIconName('chevron-left')" class="w-3.5 h-3.5"></iconify-icon>
            </button>
            <span
              class="text-[14px] font-medium truncate"
              x-text="activeDiscussion ? activeDiscussion.title : ''"
            ></span>
          </div>

          <div
            id="messages-canvas"
            class="flex-1 overflow-y-auto no-scrollbar"
          >
            <div class="max-w-[560px] w-full mx-auto px-8 py-8 space-y-6">
              <template
                x-for="(msg, idx) in (activeDiscussion ? activeDiscussion.messages : [])"
                :key="idx"
              >
                <div
                  :class="msg.sender === 'Me' ? 'flex flex-col items-end' : 'space-y-1'"
                >
                  <p
                    class="text-[12px] font-medium text-muted-foreground"
                    x-text="msg.sender === 'Me' ? 'You' : msg.sender"
                  ></p>
                  <p
                    class="text-[14px] leading-relaxed text-foreground"
                    :class="msg.sender === 'Me' ? 'max-w-[85%] px-3.5 py-2 rounded-lg bg-foreground text-background' : ''"
                    x-text="msg.text"
                  ></p>
                </div>
              </template>
            </div>
          </div>

          <div class="px-6 py-3 shrink-0">
            <div
              class="max-w-[560px] w-full mx-auto ghost-btn flex items-center gap-2 px-3 py-1.5 rounded-full focus-ring"
            >
              <input
                type="text"
                x-model="chatReplyInput"
                @keydown.enter="submitChatReply()"
                placeholder="Reply..."
                class="flex-1 bg-transparent border-none outline-none text-[14px] text-foreground"
              />
              <button
                @click="submitChatReply()"
                class="w-6 h-6 flex items-center justify-center rounded-full bg-foreground text-background hover:opacity-90"
              >
                <iconify-icon :icon="getIconName('send')" class="w-3 h-3"></iconify-icon>
              </button>
            </div>
          </div>
        </div>
      </template>
    </div>
  </div>
</div>
