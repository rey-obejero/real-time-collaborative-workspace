<div
  x-show="isSettingsModalOpen"
  x-cloak
  x-transition:enter="transition ease-out duration-150"
  x-transition:enter-start="opacity-0"
  x-transition:enter-end="opacity-100"
  x-transition:leave="transition ease-in duration-100"
  x-transition:leave-start="opacity-100"
  x-transition:leave-end="opacity-0"
  class="fixed inset-0 z-40 flex items-center justify-center p-6"
>
  <div
    @click="closeSettingsModal()"
    class="absolute inset-0 bg-black/20 backdrop-blur-[3px]"
  ></div>

  <div
    class="relative w-full max-w-2xl flex flex-col z-10 min-h-[60vh] max-h-[80vh] bg-background border border-border rounded-lg overflow-hidden modal-pop"
  >
    <button
      @click="closeSettingsModal()"
      class="absolute top-3 right-3 z-20 w-7 h-7 flex items-center justify-center rounded-full hover:bg-hover text-muted-foreground hover:text-foreground cursor-pointer"
      aria-label="Close settings"
    >
      <iconify-icon :icon="getIconName('x')" class="w-3.5 h-3.5"></iconify-icon>
    </button>

    <div class="flex flex-1 min-h-0">
      <nav
        class="w-[200px] shrink-0 border-r border-border overflow-y-auto no-scrollbar select-none bg-sidebar"
      >
        <div class="px-3 py-4 space-y-0.5">
          <p class="text-[12px] font-medium text-muted-foreground px-2 mb-1">
            Account
          </p>
          <button
            @click="activeSettingsSection = 'sec-personal-info'"
            :class="{ 'active': activeSettingsSection === 'sec-personal-info' }"
            :aria-current="activeSettingsSection === 'sec-personal-info' ? 'page' : undefined"
            class="nav-row w-full flex items-center gap-2 px-4 py-2.5 text-[14px] font-medium cursor-pointer"
          >
            <iconify-icon :icon="getIconName('user')" class="w-3.5 h-3.5"></iconify-icon>
            <span>Personal</span>
          </button>
          <button
            @click="activeSettingsSection = 'sec-preferences'"
            :class="{ 'active': activeSettingsSection === 'sec-preferences' }"
            :aria-current="activeSettingsSection === 'sec-preferences' ? 'page' : undefined"
            class="nav-row w-full flex items-center gap-2 px-4 py-2.5 text-[14px] font-medium cursor-pointer"
          >
            <iconify-icon :icon="getIconName('settings')" class="w-3.5 h-3.5"></iconify-icon>
            <span>Preferences</span>
          </button>

          <p class="text-[12px] font-medium text-muted-foreground px-2 mt-4 mb-1">
            Workspace
          </p>
          <button
            @click="activeSettingsSection = 'sec-general'"
            :class="{ 'active': activeSettingsSection === 'sec-general' }"
            :aria-current="activeSettingsSection === 'sec-general' ? 'page' : undefined"
            class="nav-row w-full flex items-center gap-2 px-4 py-2.5 text-[14px] font-medium cursor-pointer"
          >
            <iconify-icon :icon="getIconName('settings-codicon')" class="w-3.5 h-3.5"></iconify-icon>
            <span>General</span>
          </button>
          <button
            @click="activeSettingsSection = 'sec-members'"
            :class="{ 'active': activeSettingsSection === 'sec-members' }"
            :aria-current="activeSettingsSection === 'sec-members' ? 'page' : undefined"
            class="nav-row w-full flex items-center gap-2 px-4 py-2.5 text-[14px] font-medium cursor-pointer"
          >
            <iconify-icon :icon="getIconName('user')" class="w-3.5 h-3.5"></iconify-icon>
            <span>Members</span>
          </button>
          <button
            @click="activeSettingsSection = 'sec-schemas'"
            :class="{ 'active': activeSettingsSection === 'sec-schemas' }"
            :aria-current="activeSettingsSection === 'sec-schemas' ? 'page' : undefined"
            class="nav-row w-full flex items-center gap-2 px-4 py-2.5 text-[14px] font-medium cursor-pointer"
          >
            <iconify-icon :icon="getIconName('plugin')" class="w-3.5 h-3.5"></iconify-icon>
            <span>Schemas</span>
          </button>
          <button
            @click="activeSettingsSection = 'sec-properties'"
            :class="{ 'active': activeSettingsSection === 'sec-properties' }"
            :aria-current="activeSettingsSection === 'sec-properties' ? 'page' : undefined"
            class="nav-row w-full flex items-center gap-2 px-4 py-2.5 text-[14px] font-medium cursor-pointer"
          >
            <iconify-icon :icon="getIconName('list-check')" class="w-3.5 h-3.5"></iconify-icon>
            <span>Properties</span>
          </button>
        </div>
      </nav>

      <div class="wv-scroll flex-1 min-w-0 overflow-y-auto no-scrollbar">
        <section
          id="sec-personal-info"
          class="settings-section"
          x-show="activeSettingsSection === 'sec-personal-info'"
          x-cloak
          x-transition:enter="transition ease-out duration-150"
          x-transition:enter-start="opacity-0"
          x-transition:enter-end="opacity-100"
          x-transition:leave="transition ease-in duration-100"
          x-transition:leave-start="opacity-100"
          x-transition:leave-end="opacity-0"
        >
          <h4 class="wv-sec-h !mt-0">Personal</h4>
          <p class="wv-subtitle mb-4">Your account profile across workspaces.</p>
          <div class="wv-field">
            <label class="wv-field-label">Profile</label>
            <div class="flex items-center gap-3 py-2">
              <img
                src="https://api.dicebear.com/10.x/initials/svg?initialsVariant=alt:1&lettersVariant=single:0&backgroundColor=000000&textColor=ffffff&seed=John"
                alt=""
                class="w-7 h-7 rounded-full shrink-0"
              />
              <div class="min-w-0">
                <p class="wv-row-label truncate">John Doe</p>
                <p class="wv-row-meta truncate">john.doe@example.com</p>
              </div>
            </div>
          </div>
        </section>

        <section
          id="sec-preferences"
          class="settings-section"
          x-show="activeSettingsSection === 'sec-preferences'"
          x-cloak
          x-transition:enter="transition ease-out duration-150"
          x-transition:enter-start="opacity-0"
          x-transition:enter-end="opacity-100"
          x-transition:leave="transition ease-in duration-100"
          x-transition:leave-start="opacity-100"
          x-transition:leave-end="opacity-0"
        >
          <h4 class="wv-sec-h !mt-0">Preferences</h4>
          <p class="wv-subtitle mb-4">Interface and behavior settings.</p>
          <div class="wv-row !py-3">
            <div class="flex flex-col gap-1 min-w-0">
              <span class="wv-row-label">Appearance</span>
              <span class="wv-row-meta">Switch between light and dark mode</span>
            </div>
            <button
              @click="isDarkMode = !isDarkMode; document.documentElement.classList.toggle('dark', isDarkMode)"
              class="wv-btn inline-flex items-center gap-1.5 px-3 py-1.5 text-[12px] font-medium border border-border bg-transparent hover:bg-hover cursor-pointer"
            >
              <iconify-icon :icon="isDarkMode ? getIconName('moon') : getIconName('sun')" class="w-3.5 h-3.5"></iconify-icon>
              <span x-text="isDarkMode ? 'Dark' : 'Light'"></span>
            </button>
          </div>
        </section>

        <section
          id="sec-general"
          class="settings-section"
          x-show="activeSettingsSection === 'sec-general'"
          x-cloak
          x-transition:enter="transition ease-out duration-150"
          x-transition:enter-start="opacity-0"
          x-transition:enter-end="opacity-100"
          x-transition:leave="transition ease-in duration-100"
          x-transition:leave-start="opacity-100"
          x-transition:leave-end="opacity-0"
        >
          <h4 class="wv-sec-h !mt-0">General</h4>
          <p class="wv-subtitle mb-4">Workspace identity and defaults.</p>
          <div class="wv-field">
            <label class="wv-field-label">Workspace Name</label>
            <input
              type="text"
              x-model="workspaceNameInput"
              class="wv-btn wv-input bg-input px-3 py-1.5 text-[12px] text-foreground border border-border focus-ring"
            />
          </div>
        </section>

        <section
          id="sec-members"
          class="settings-section"
          x-show="activeSettingsSection === 'sec-members'"
          x-cloak
          x-transition:enter="transition ease-out duration-150"
          x-transition:enter-start="opacity-0"
          x-transition:enter-end="opacity-100"
          x-transition:leave="transition ease-in duration-100"
          x-transition:leave-start="opacity-100"
          x-transition:leave-end="opacity-0"
        >
          <h4 class="wv-sec-h !mt-0">Members</h4>
          <p class="wv-subtitle mb-3">Invite and manage members who can access this workspace.</p>

          <button @click="openAddMemberModal()" class="wv-btn inline-flex items-center px-3 py-1.5 text-[12px] font-medium bg-primary text-primary-foreground hover:bg-primary/80 cursor-pointer mb-5">
            Add members
          </button>

          <p class="text-[12px] text-muted-foreground mb-2">Other options</p>

          <div class="flex flex-wrap items-center gap-2 mb-4">
            <button class="wv-btn inline-flex items-center gap-1.5 px-3 py-1.5 text-[12px] font-medium border border-border bg-transparent hover:bg-hover cursor-pointer">
              <iconify-icon :icon="getIconName('link')" class="w-3.5 h-3.5"></iconify-icon>
              Copy link
            </button>
            <button class="wv-btn inline-flex items-center gap-1.5 px-3 py-1.5 text-[12px] font-medium border border-border bg-transparent hover:bg-hover cursor-pointer">
              <iconify-icon :icon="getIconName('qrcode')" class="w-3.5 h-3.5"></iconify-icon>
              QR code
            </button>
            <button class="wv-btn inline-flex items-center gap-1.5 px-3 py-1.5 text-[12px] font-medium border border-border bg-transparent hover:bg-hover cursor-pointer">
              <iconify-icon :icon="getIconName('settings')" class="w-3.5 h-3.5"></iconify-icon>
              Manage link
            </button>
          </div>

          <p class="text-[12px] text-muted-foreground mb-2">All <span x-text="members.length"></span></p>

          <template x-for="m in members" :key="m.email">
            <div class="wv-member-row" x-data="{ role: m.role, roleDropdownOpen: false }">
              <div class="flex items-center gap-2.5 min-w-0">
                <img
                  :src="'https://api.dicebear.com/10.x/initials/svg?initialsVariant=alt:1&lettersVariant=single:0&backgroundColor=000000&textColor=ffffff&seed=' + m.name"
                  alt=""
                  class="w-7 h-7 rounded-full shrink-0"
                />
                <div class="truncate">
                  <p class="text-[14px] font-medium leading-tight text-foreground" x-text="m.name"></p>
                  <p class="text-[12px] text-muted-foreground leading-tight" x-text="m.email"></p>
                </div>
              </div>
              <div class="relative flex items-center shrink-0">
                <button
                  @click="roleDropdownOpen = !roleDropdownOpen"
                  class="wv-btn flex items-center gap-1 text-[12px] font-medium text-foreground cursor-pointer px-2 py-1 border border-border bg-transparent hover:bg-hover"
                >
                  <span x-text="role.charAt(0).toUpperCase() + role.slice(1)"></span>
                  <iconify-icon :icon="getIconName('chevron-down')" class="w-3 h-3 text-muted-foreground"></iconify-icon>
                </button>
                <div
                  x-show="roleDropdownOpen"
                  @click.outside="roleDropdownOpen = false"
                  x-cloak
                  x-transition
                  class="floating-pop absolute top-full right-0 mt-1 z-30 rounded-md overflow-hidden bg-background border border-border p-1.5 min-w-[100px]"
                >
                  <button
                    @click="role = 'owner'; roleDropdownOpen = false"
                    :class="role === 'owner' ? 'bg-accent' : ''"
                    class="w-full text-left px-3 py-1.5 text-[12px] flex items-center hover:bg-hover cursor-pointer rounded-[4px]"
                  >Owner</button>
                  <button
                    @click="role = 'editor'; roleDropdownOpen = false"
                    :class="role === 'editor' ? 'bg-accent' : ''"
                    class="w-full text-left px-3 py-1.5 text-[12px] flex items-center hover:bg-hover cursor-pointer rounded-[4px]"
                  >Editor</button>
                  <button
                    @click="role = 'member'; roleDropdownOpen = false"
                    :class="role === 'member' ? 'bg-accent' : ''"
                    class="w-full text-left px-3 py-1.5 text-[12px] flex items-center hover:bg-hover cursor-pointer rounded-[4px]"
                  >Member</button>
                </div>
              </div>
            </div>
          </template>
        </section>

        <section
          id="sec-schemas"
          class="settings-section"
          x-show="activeSettingsSection === 'sec-schemas'"
          x-cloak
          x-transition:enter="transition ease-out duration-150"
          x-transition:enter-start="opacity-0"
          x-transition:enter-end="opacity-100"
          x-transition:leave="transition ease-in duration-100"
          x-transition:leave-start="opacity-100"
          x-transition:leave-end="opacity-0"
        >
          <h4 class="wv-sec-h !mt-0">Schemas</h4>
          <p class="wv-subtitle mb-4">Entry types available in this workspace.</p>
          <template x-for="schema in schemas" :key="schema.id">
            <div>
              <div class="wv-row">
                <div class="flex items-center gap-2 min-w-0">
                  <iconify-icon :icon="getIconName(schema.id)" class="w-4 h-4 text-muted-foreground"></iconify-icon>
                  <span class="wv-row-label truncate" x-text="schema.name"></span>
                </div>
                <div class="flex items-center gap-3">
                  <button class="wv-btn px-2.5 py-1 text-[12px] font-medium border border-border bg-transparent hover:bg-hover cursor-pointer">Edit</button>
                </div>
              </div>
              <div class="wv-row-divider"></div>
            </div>
          </template>
        </section>

        <section
          id="sec-properties"
          class="settings-section"
          x-show="activeSettingsSection === 'sec-properties'"
          x-cloak
          x-transition:enter="transition ease-out duration-150"
          x-transition:enter-start="opacity-0"
          x-transition:enter-end="opacity-100"
          x-transition:leave="transition ease-in duration-100"
          x-transition:leave-start="opacity-100"
          x-transition:leave-end="opacity-0"
        >
          <h4 class="wv-sec-h !mt-0">Properties</h4>
          <p class="wv-subtitle mb-4">Properties available on entry types across this workspace.</p>
          <div class="wv-row">
            <div class="flex flex-col gap-0.5 min-w-0">
              <span class="wv-row-label">Status</span>
              <span class="wv-row-meta">Page, Task, Project</span>
            </div>
          </div>
          <div class="wv-row-divider"></div>
          <div class="wv-row">
            <div class="flex flex-col gap-0.5 min-w-0">
              <span class="wv-row-label">Priority</span>
              <span class="wv-row-meta">Task, Project</span>
            </div>
          </div>
          <div class="wv-row-divider"></div>
          <div class="wv-row">
            <div class="flex flex-col gap-0.5 min-w-0">
              <span class="wv-row-label">Due date</span>
              <span class="wv-row-meta">Task, Project</span>
            </div>
          </div>
          <div class="wv-row-divider"></div>
          <div class="wv-row">
            <div class="flex flex-col gap-0.5 min-w-0">
              <span class="wv-row-label">Assignee</span>
              <span class="wv-row-meta">Task, Project</span>
            </div>
          </div>
          <div class="wv-row-divider"></div>
          <div class="wv-row">
            <div class="flex flex-col gap-0.5 min-w-0">
              <span class="wv-row-label">Owner</span>
              <span class="wv-row-meta">Page, Note</span>
            </div>
          </div>
          <div class="wv-row-divider"></div>
          <div class="wv-row">
            <div class="flex flex-col gap-0.5 min-w-0">
              <span class="wv-row-label">URL</span>
              <span class="wv-row-meta">Bookmark</span>
            </div>
          </div>
          <div class="wv-row-divider"></div>
          <div class="wv-row">
            <div class="flex flex-col gap-0.5 min-w-0">
              <span class="wv-row-label">Tags</span>
              <span class="wv-row-meta">All types</span>
            </div>
          </div>
        </section>
      </div>
    </div>
  </div>
</div>

<div
  x-show="isAddMemberModalOpen"
  x-cloak
  x-transition:enter="transition ease-out duration-150"
  x-transition:enter-start="opacity-0"
  x-transition:enter-end="opacity-100"
  x-transition:leave="transition ease-in duration-100"
  x-transition:leave-start="opacity-100"
  x-transition:leave-end="opacity-0"
  class="fixed inset-0 z-50 flex items-center justify-center p-6"
>
  <div
    @click="closeAddMemberModal()"
    class="absolute inset-0 bg-black/20 backdrop-blur-[3px]"
  ></div>

  <div
    class="relative w-full max-w-xs flex flex-col z-10 bg-background border border-border rounded-lg overflow-hidden modal-pop"
  >
    <button
      @click="closeAddMemberModal()"
      class="absolute top-3 right-3 z-20 w-7 h-7 flex items-center justify-center rounded-full hover:bg-hover text-muted-foreground hover:text-foreground cursor-pointer"
      aria-label="Close"
    >
      <iconify-icon :icon="getIconName('x')" class="w-3.5 h-3.5"></iconify-icon>
    </button>

    <div class="px-5 pt-5 pb-3">
      <h4 class="text-[20px] font-medium text-foreground !mt-0">Add member</h4>
      <p class="wv-subtitle mb-2">Enter a username or email to send an invite.</p>
      <div class="wv-field">
        <input
          type="text"
          x-model="addMemberInput"
          @keydown.enter="addMember()"
          placeholder="Username or email"
          class="wv-btn bg-input px-3 py-1.5 text-[12px] text-foreground border border-border focus-ring w-full"
        />
      </div>
    </div>
    <hr class="border-border mt-0" />
    <div class="flex items-center justify-end gap-2 px-5 pb-5 pt-3">
      <button
        @click="closeAddMemberModal()"
        class="wv-btn inline-flex items-center px-3 py-1.5 text-[12px] font-medium border border-border bg-transparent hover:bg-hover cursor-pointer"
      >
        Cancel
      </button>
      <button
        @click="addMember()"
        class="wv-btn inline-flex items-center px-3 py-1.5 text-[12px] font-medium bg-primary text-primary-foreground hover:bg-primary/80 cursor-pointer"
      >
        Add member
      </button>
    </div>
  </div>
</div>
