---
import WorkspaceLayout from "../layouts/WorkspaceLayout.astro";
import Sidebar from "../components/Sidebar.astro";
import MainHeader from "../components/MainHeader.astro";
import ListView from "../components/ListView.astro";
import EditorView from "../components/EditorView.astro";
import Conversations from "../components/Conversations.astro";
import FloatingToolbar from "../components/FloatingToolbar.astro";
import SlashMenu from "../components/SlashMenu.astro";
import SettingsModal from "../components/SettingsModal.astro";
import SearchModal from "../components/SearchModal.astro";
import TweaksToolbar from "../components/TweaksToolbar.astro";
---
<WorkspaceLayout>
  <div class="h-full w-full flex bg-background">
    <Sidebar />
    <main class="flex-1 flex flex-col h-full overflow-hidden">
      <MainHeader />
      <div class="flex-1 flex flex-col overflow-hidden relative">
        <ListView />
        <EditorView />
        <Conversations />
      </div>
    </main>
    <FloatingToolbar />
    <SlashMenu />
    <SettingsModal />
    <SearchModal />
    <TweaksToolbar />
  </div>
</WorkspaceLayout>
