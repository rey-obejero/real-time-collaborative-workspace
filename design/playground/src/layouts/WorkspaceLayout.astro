---
import "../styles/global.css";
---
<!doctype html>
<html lang="en" class="h-full" x-data="workspace()" :class="{ 'dark': isDarkMode }">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Workspace</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600&family=Geist:wght@400;500&family=Geist+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <script>import "../scripts/workspace";</script>
    <script>import 'iconify-icon';</script>
  </head>
  <body
    class="h-full overflow-hidden text-foreground"
    :class="bodyTweakClass"
    :style="bodyTweakStyle"
  >
    <slot />
  <!-- impeccable-live-start -->
<script is:inline src="http://localhost:8400/live.js?token=e9df62bb-bcc7-40e8-8b62-20c3f57e9d5d"></script>
<!-- impeccable-live-end -->
</body>
</html>
