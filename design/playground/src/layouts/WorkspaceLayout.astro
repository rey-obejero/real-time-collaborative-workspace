---
import "../styles/global.css";
---
<!doctype html>
<html lang="en" class="h-full" x-data="workspace()" :class="{ 'dark': isDarkMode }">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Workspace</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600&family=Inter:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <script defer src="/scripts/workspace.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <script>import 'iconify-icon';</script>
  </head>
  <body
    class="h-full overflow-hidden select-none text-foreground"
    :class="{
      'tweaks-compact': tweaks.density === 'compact',
      'tweaks-card-flat': tweaks.cardEdge === 'flat',
      'tweaks-sidebar-soft': tweaks.sidebarFill === 'soft',
      'tweaks-chips-bordered': tweaks.chipStyle === 'bordered',
      'tweaks-status-label': tweaks.statusStyle === 'label'
    }"
  >
    <slot />
  </body>
</html>
