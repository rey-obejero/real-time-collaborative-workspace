<div
  class="fixed bottom-4 left-1/2 -translate-x-1/2 z-[60] select-none"
  @click.outside="tweaksOpen = false"
  @keydown.escape.window="tweaksOpen = false"
>
  <button
    x-show="!tweaksOpen"
    @click="tweaksOpen = true"
    class="bg-secondary w-9 h-9 flex items-center justify-center rounded-full hover:bg-accent"
    title="Design tweaks"
  >
    <iconify-icon :icon="getIconName('tweaks')" class="w-4 h-4"></iconify-icon>
  </button>

  <div
    x-show="tweaksOpen"
    x-transition.opacity.duration.150
    class="bg-popover border border-border rounded-lg p-4 w-[260px] space-y-3"
  >
    <div class="flex items-center justify-between">
      <span class="text-[14px] font-medium text-foreground">Tweaks</span>
      <button @click="tweaksOpen = false" class="w-6 h-6 flex items-center justify-center rounded-full hover:bg-secondary text-muted-foreground">
        <iconify-icon :icon="getIconName('x')" class="w-3.5 h-3.5"></iconify-icon>
      </button>
    </div>

    <div class="space-y-1.5">
      <span class="text-[12px] text-muted-foreground">Density</span>
      <div class="flex gap-1.5">
        <button
          @click="toggleTweak('density', 'default')"
          :class="tweaks.density === 'default' ? 'primary-btn' : 'ghost-btn'"
          class="flex-1 h-7 flex items-center justify-center text-[12px] font-medium rounded-full"
        >Default</button>
        <button
          @click="toggleTweak('density', 'compact')"
          :class="tweaks.density === 'compact' ? 'primary-btn' : 'ghost-btn'"
          class="flex-1 h-7 flex items-center justify-center text-[12px] font-medium rounded-full"
        >Compact</button>
      </div>
    </div>

    <div class="border-t border-border"></div>

    <div class="space-y-1.5">
      <span class="text-[12px] text-muted-foreground">Card Edge</span>
      <div class="flex gap-1.5">
        <button
          @click="toggleTweak('cardEdge', 'hairline')"
          :class="tweaks.cardEdge === 'hairline' ? 'primary-btn' : 'ghost-btn'"
          class="flex-1 h-7 flex items-center justify-center text-[12px] font-medium rounded-full"
        >Hairline</button>
        <button
          @click="toggleTweak('cardEdge', 'flat')"
          :class="tweaks.cardEdge === 'flat' ? 'primary-btn' : 'ghost-btn'"
          class="flex-1 h-7 flex items-center justify-center text-[12px] font-medium rounded-full"
        >Flat</button>
      </div>
    </div>

    <div class="border-t border-border"></div>

    <div class="space-y-1.5">
      <span class="text-[12px] text-muted-foreground">Sidebar Fill</span>
      <div class="flex gap-1.5">
        <button
          @click="toggleTweak('sidebarFill', 'canvas')"
          :class="tweaks.sidebarFill === 'canvas' ? 'primary-btn' : 'ghost-btn'"
          class="flex-1 h-7 flex items-center justify-center text-[12px] font-medium rounded-full"
        >White</button>
        <button
          @click="toggleTweak('sidebarFill', 'soft')"
          :class="tweaks.sidebarFill === 'soft' ? 'primary-btn' : 'ghost-btn'"
          class="flex-1 h-7 flex items-center justify-center text-[12px] font-medium rounded-full"
        >Soft</button>
      </div>
    </div>

    <div class="border-t border-border"></div>

    <div class="space-y-1.5">
      <span class="text-[12px] text-muted-foreground">Chips</span>
      <div class="flex gap-1.5">
        <button
          @click="toggleTweak('chipStyle', 'soft')"
          :class="tweaks.chipStyle === 'soft' ? 'primary-btn' : 'ghost-btn'"
          class="flex-1 h-7 flex items-center justify-center text-[12px] font-medium rounded-full"
        >Soft</button>
        <button
          @click="toggleTweak('chipStyle', 'bordered')"
          :class="tweaks.chipStyle === 'bordered' ? 'primary-btn' : 'ghost-btn'"
          class="flex-1 h-7 flex items-center justify-center text-[12px] font-medium rounded-full"
        >Bordered</button>
      </div>
    </div>

    <div class="border-t border-border"></div>

    <div class="space-y-1.5">
      <span class="text-[12px] text-muted-foreground">Status</span>
      <div class="flex gap-1.5">
        <button
          @click="toggleTweak('statusStyle', 'dot')"
          :class="tweaks.statusStyle === 'dot' ? 'primary-btn' : 'ghost-btn'"
          class="flex-1 h-7 flex items-center justify-center text-[12px] font-medium rounded-full"
        >Dot</button>
        <button
          @click="toggleTweak('statusStyle', 'label')"
          :class="tweaks.statusStyle === 'label' ? 'primary-btn' : 'ghost-btn'"
          class="flex-1 h-7 flex items-center justify-center text-[12px] font-medium rounded-full"
        >Label</button>
      </div>
    </div>

    <div class="border-t border-border"></div>

    <div class="space-y-1.5">
      <span class="text-[12px] text-muted-foreground">Icons</span>
      <div class="flex gap-1">
        <button
          @click="toggleTweak('iconSet', 'mage')"
          :class="tweaks.iconSet === 'mage' ? 'primary-btn' : 'ghost-btn'"
          class="flex-1 h-7 flex items-center justify-center text-[11px] font-medium rounded-full"
        >Mage</button>
        <button
          @click="toggleTweak('iconSet', 'feather')"
          :class="tweaks.iconSet === 'feather' ? 'primary-btn' : 'ghost-btn'"
          class="flex-1 h-7 flex items-center justify-center text-[11px] font-medium rounded-full"
        >Feath</button>
        <button
          @click="toggleTweak('iconSet', 'heroicons')"
          :class="tweaks.iconSet === 'heroicons' ? 'primary-btn' : 'ghost-btn'"
          class="flex-1 h-7 flex items-center justify-center text-[11px] font-medium rounded-full"
        >Hero</button>
        <button
          @click="toggleTweak('iconSet', 'phosphor')"
          :class="tweaks.iconSet === 'phosphor' ? 'primary-btn' : 'ghost-btn'"
          class="flex-1 h-7 flex items-center justify-center text-[11px] font-medium rounded-full"
        >Phos</button>
        <button
          @click="toggleTweak('iconSet', 'hugeicons')"
          :class="tweaks.iconSet === 'hugeicons' ? 'primary-btn' : 'ghost-btn'"
          class="flex-1 h-7 flex items-center justify-center text-[11px] font-medium rounded-full"
        >Huge</button>
      </div>
    </div>

    <div class="border-t border-border pt-2">
      <button
        @click="resetTweaks()"
        class="text-[12px] underline-offset-2 hover:underline text-muted-foreground"
      >Reset defaults</button>
    </div>
  </div>
</div>
