<div
  class="fixed bottom-4 right-4 z-[60] select-none"
  @click.outside="tweaksOpen = false"
  @keydown.escape.window="tweaksOpen = false"
>
  <button
    x-show="!tweaksOpen"
    @click="tweaksOpen = true"
    class="bg-secondary w-9 h-9 flex items-center justify-center rounded-full hover:bg-accent border border-border cursor-pointer"
    title="Design tweaks"
  >
    <iconify-icon :icon="getIconName('tweaks')" class="w-4 h-4"></iconify-icon>
  </button>

  <div
    x-show="tweaksOpen"
    x-transition.opacity.duration.150
    class="bg-popover border border-border rounded-lg p-4 w-[280px] space-y-4"
    style="max-height: 80vh; overflow-y: auto;"
  >
    <div class="flex items-center justify-between">
      <span class="text-[14px] font-medium text-foreground">Tweaks</span>
      <button @click="tweaksOpen = false" class="w-6 h-6 flex items-center justify-center rounded-full hover:bg-secondary text-muted-foreground">
        <iconify-icon :icon="getIconName('x')" class="w-3.5 h-3.5"></iconify-icon>
      </button>
    </div>

    <div
      x-data="{ sidebarOpen: true }"
    >
      <button
        @click="sidebarOpen = !sidebarOpen"
        class="w-full flex items-center gap-2 text-[12px] font-medium text-muted-foreground uppercase tracking-wider cursor-pointer"
      >
        <span class="transition inline-flex items-center" :class="sidebarOpen ? 'rotate-90' : ''">
          <iconify-icon :icon="getIconName('chevron-down')" class="w-3 h-3"></iconify-icon>
        </span>
        Sidebar Options
      </button>

      <div x-show="sidebarOpen" x-transition:enter.duration.100 class="pt-3 space-y-4">

        <div>
          <p class="text-[12px] font-medium text-foreground mb-2">Action Height</p>
          <div class="flex gap-1">
            <template x-for="(label, val) in { low: 'Low', medium: 'Med', high: 'High' }">
              <button
                @click="toggleTweak('sidebarActionHeight', val)"
                :class="tweaks.sidebarActionHeight === val ? 'bg-primary text-primary-foreground' : 'bg-secondary text-muted-foreground hover:bg-accent'"
                class="flex-1 px-2 py-1 text-[12px] rounded-full cursor-pointer"
                x-text="label"
              ></button>
            </template>
          </div>
        </div>

        <div>
          <p class="text-[12px] font-medium text-foreground mb-2">Hover BG</p>
          <div class="flex gap-1">
            <template x-for="(label, val) in { low: 'Low', medium: 'Med', high: 'High' }">
              <button
                @click="toggleTweak('sidebarHover', val)"
                :class="tweaks.sidebarHover === val ? 'bg-primary text-primary-foreground' : 'bg-secondary text-muted-foreground hover:bg-accent'"
                class="flex-1 px-2 py-1 text-[12px] rounded-full cursor-pointer"
                x-text="label"
              ></button>
            </template>
          </div>
        </div>

        <div>
          <p class="text-[12px] font-medium text-foreground mb-2">Avatar Shape</p>
          <div class="flex gap-1">
            <button
              @click="toggleTweak('avatarShape', 'circle')"
              :class="tweaks.avatarShape === 'circle' ? 'bg-primary text-primary-foreground' : 'bg-secondary text-muted-foreground hover:bg-accent'"
              class="flex-1 px-2 py-1 text-[12px] rounded-full cursor-pointer"
            >Circle</button>
            <button
              @click="toggleTweak('avatarShape', 'square')"
              :class="tweaks.avatarShape === 'square' ? 'bg-primary text-primary-foreground' : 'bg-secondary text-muted-foreground hover:bg-accent'"
              class="flex-1 px-2 py-1 text-[12px] rounded-full cursor-pointer"
            >Square</button>
          </div>
        </div>

        <div>
          <p class="text-[12px] font-medium text-foreground mb-2">Search Shape</p>
          <div class="flex gap-1">
            <button
              @click="toggleTweak('searchShape', 'pill')"
              :class="tweaks.searchShape === 'pill' ? 'bg-primary text-primary-foreground' : 'bg-secondary text-muted-foreground hover:bg-accent'"
              class="flex-1 px-2 py-1 text-[12px] rounded-full cursor-pointer"
            >Pill</button>
            <button
              @click="toggleTweak('searchShape', 'rect')"
              :class="tweaks.searchShape === 'rect' ? 'bg-primary text-primary-foreground' : 'bg-secondary text-muted-foreground hover:bg-accent'"
              class="flex-1 px-2 py-1 text-[12px] rounded-full cursor-pointer"
            >Rect</button>
          </div>
        </div>

        <div>
          <p class="text-[12px] font-medium text-foreground mb-2">Search Color</p>
          <div class="flex gap-1">
            <template x-for="(label, val) in { white: 'White', 'hover-low': 'Low', 'hover-medium': 'Med', 'hover-high': 'High' }">
              <button
                @click="toggleTweak('searchBg', val)"
                :class="tweaks.searchBg === val ? 'bg-primary text-primary-foreground' : 'bg-secondary text-muted-foreground hover:bg-accent'"
                class="flex-1 px-2 py-1 text-[12px] rounded-full cursor-pointer"
                x-text="label"
              ></button>
            </template>
          </div>
        </div>

        <div>
          <p class="text-[12px] font-medium text-foreground mb-2">Search Border</p>
          <div class="flex gap-1">
            <button
              @click="toggleTweak('searchBorder', 'hairline')"
              :class="tweaks.searchBorder === 'hairline' ? 'bg-primary text-primary-foreground' : 'bg-secondary text-muted-foreground hover:bg-accent'"
              class="flex-1 px-2 py-1 text-[12px] rounded-full cursor-pointer"
            >Hairline</button>
            <button
              @click="toggleTweak('searchBorder', 'none')"
              :class="tweaks.searchBorder === 'none' ? 'bg-primary text-primary-foreground' : 'bg-secondary text-muted-foreground hover:bg-accent'"
              class="flex-1 px-2 py-1 text-[12px] rounded-full cursor-pointer"
            >None</button>
          </div>
        </div>

        <div>
          <p class="text-[12px] font-medium text-foreground mb-2">Icon Size</p>
          <div class="flex gap-1">
            <button
              @click="toggleTweak('iconSize', 'sm')"
              :class="tweaks.iconSize === 'sm' ? 'bg-primary text-primary-foreground' : 'bg-secondary text-muted-foreground hover:bg-accent'"
              class="flex-1 px-2 py-1 text-[12px] rounded-full cursor-pointer"
            >Sm</button>
            <button
              @click="toggleTweak('iconSize', 'md')"
              :class="tweaks.iconSize === 'md' ? 'bg-primary text-primary-foreground' : 'bg-secondary text-muted-foreground hover:bg-accent'"
              class="flex-1 px-2 py-1 text-[12px] rounded-full cursor-pointer"
            >Md</button>
            <button
              @click="toggleTweak('iconSize', 'lg')"
              :class="tweaks.iconSize === 'lg' ? 'bg-primary text-primary-foreground' : 'bg-secondary text-muted-foreground hover:bg-accent'"
              class="flex-1 px-2 py-1 text-[12px] rounded-full cursor-pointer"
            >Lg</button>
          </div>
        </div>

        <div>
          <p class="text-[12px] font-medium text-foreground mb-2">Icon Stroke</p>
          <div class="flex gap-1">
            <button
              @click="toggleTweak('iconStroke', 'thin')"
              :class="tweaks.iconStroke === 'thin' ? 'bg-primary text-primary-foreground' : 'bg-secondary text-muted-foreground hover:bg-accent'"
              class="flex-1 px-2 py-1 text-[12px] rounded-full cursor-pointer"
            >Thin</button>
            <button
              @click="toggleTweak('iconStroke', 'normal')"
              :class="tweaks.iconStroke === 'normal' ? 'bg-primary text-primary-foreground' : 'bg-secondary text-muted-foreground hover:bg-accent'"
              class="flex-1 px-2 py-1 text-[12px] rounded-full cursor-pointer"
            >Normal</button>
            <button
              @click="toggleTweak('iconStroke', 'thick')"
              :class="tweaks.iconStroke === 'thick' ? 'bg-primary text-primary-foreground' : 'bg-secondary text-muted-foreground hover:bg-accent'"
              class="flex-1 px-2 py-1 text-[12px] rounded-full cursor-pointer"
            >Thick</button>
          </div>
        </div>

        <div>
          <p class="text-[12px] font-medium text-foreground mb-2">Action Pad X</p>
          <div class="flex gap-1">
            <template x-for="(label, val) in { low: 'Low', medium: 'Med', high: 'High' }">
              <button
                @click="toggleTweak('sidebarPadX', val)"
                :class="tweaks.sidebarPadX === val ? 'bg-primary text-primary-foreground' : 'bg-secondary text-muted-foreground hover:bg-accent'"
                class="flex-1 px-2 py-1 text-[12px] rounded-full cursor-pointer"
                x-text="label"
              ></button>
            </template>
          </div>
        </div>

        <div>
          <p class="text-[12px] font-medium text-foreground mb-2">Element Hover</p>
          <div class="flex gap-1">
            <template x-for="(label, val) in { default: 'Default', 'hover-low': 'Low', 'hover-medium': 'Med', 'hover-high': 'High' }">
              <button
                @click="toggleTweak('elementBg', val)"
                :class="tweaks.elementBg === val ? 'bg-primary text-primary-foreground' : 'bg-secondary text-muted-foreground hover:bg-accent'"
                class="flex-1 px-2 py-1 text-[12px] rounded-full cursor-pointer"
                x-text="label"
              ></button>
            </template>
          </div>
        </div>

        <div>
          <p class="text-[12px] font-medium text-foreground mb-2">Icon Hover</p>
          <div class="flex gap-1">
            <template x-for="(label, val) in { default: 'Default', 'hover-low': 'Low', 'hover-medium': 'Med', 'hover-high': 'High' }">
              <button
                @click="toggleTweak('elementIcon', val)"
                :class="tweaks.elementIcon === val ? 'bg-primary text-primary-foreground' : 'bg-secondary text-muted-foreground hover:bg-accent'"
                class="flex-1 px-2 py-1 text-[12px] rounded-full cursor-pointer"
                x-text="label"
              ></button>
            </template>
          </div>
        </div>

      </div>
    </div>
  </div>
</div>