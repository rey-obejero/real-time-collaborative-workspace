<div
  x-show="isSettingsModalOpen"
  x-cloak
  x-transition:enter="transition ease-out duration-150"
  x-transition:enter-start="opacity-0"
  x-transition:enter-end="opacity-100"
  x-transition:leave="transition ease-in duration-100"
  x-transition:leave-start="opacity-100"
  x-transition:leave-end="opacity-0"
  class="fixed inset-0 z-40 flex items-center justify-center p-6"
>
  <div
    @click="closeSettingsModal()"
    class="absolute inset-0 bg-black/20 backdrop-blur-[3px]"
  ></div>

  <div
    class="relative w-full max-w-2xl flex flex-col z-10 max-h-[80vh] bg-popover border border-border rounded-lg overflow-hidden"
  >
    <div class="wv-header shrink-0">
      <div class="flex items-center justify-between">
        <h2 class="text-[20px] font-display font-medium text-foreground">Settings</h2>
        <button
          @click="closeSettingsModal()"
          class="wv-close flex items-center justify-center hover:bg-accent focus-ring"
        >
          <iconify-icon :icon="getIconName('x')" class="w-3.5 h-3.5"></iconify-icon>
        </button>
      </div>
    </div>

    <div
      id="modal-scroll-canvas"
      class="wv-scroll flex-1 overflow-y-auto no-scrollbar scroll-smooth"
    >
      <section id="sec-general" class="settings-section">
        <h4 class="wv-sec-h">General</h4>
        <div class="wv-field">
          <label class="wv-field-label">Workspace Name</label>
          <input type="text" x-model="workspaceNameInput" class="ghost-btn wv-btn wv-input px-3 py-1.5 text-[12px] font-medium focus-ring text-foreground" />
        </div>
      </section>

      <div class="wv-rule"></div>

      <section id="sec-members" class="settings-section">
        <h4 class="wv-sec-h">Members</h4>
        <div class="wv-row">
          <span class="wv-row-label">Invite teammate</span>
          <button
            @click="isInviteBoxExpanded = !isInviteBoxExpanded"
            class="ghost-btn wv-btn px-2.5 py-1 text-[12px] font-medium focus-ring"
          >
            + Invite
          </button>
        </div>
        <div
          x-show="isInviteBoxExpanded"
          x-transition
          class="p-2 space-y-2 rounded-lg bg-secondary"
        >
          <div class="flex gap-2">
            <input x-model="inviteEmail" type="email" placeholder="teammate@email.co" class="ghost-btn wv-btn flex-1 px-3 py-1.5 text-[12px] focus-ring text-foreground" />
            <button @click="addMember()" class="primary-btn wv-btn px-3 py-1.5 text-[12px] font-medium">Send</button>
          </div>
        </div>
        <template x-for="m in members" :key="m.email">
          <div class="wv-row">
            <div class="flex items-center gap-2 min-w-0">
              <span class="avatar-chip" x-text="m.initials">ME</span>
              <div class="truncate">
                <p class="text-[14px] font-medium leading-tight text-foreground" x-text="m.name"></p>
                <p class="wv-row-meta" x-text="m.email"></p>
              </div>
            </div>
            <span class="wv-row-meta font-medium" x-text="m.role">OWNER</span>
          </div>
        </template>
      </section>

      <div class="wv-rule"></div>

      <section id="sec-schemas" class="settings-section">
        <h4 class="wv-sec-h">Schemas</h4>
        <template x-for="schema in schemas" :key="schema.id">
          <div class="wv-row">
            <div class="flex items-center gap-2 min-w-0">
              <iconify-icon :icon="getIconName(schema.id)" class="w-4 h-4 text-muted-foreground"></iconify-icon>
              <span class="wv-row-label truncate" x-text="schema.name"></span>
            </div>
            <div class="flex items-center gap-3">
              <span class="wv-row-meta" x-text="countByType(schema.id) + ' entries'"></span>
              <button class="ghost-btn wv-btn px-2.5 py-1 text-[12px] font-medium focus-ring">Edit</button>
            </div>
          </div>
        </template>
      </section>
    </div>
  </div>
</div>
