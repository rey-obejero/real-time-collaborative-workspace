<div
  x-show="isSettingsModalOpen"
  x-cloak
  x-transition:enter="transition ease-out duration-150"
  x-transition:enter-start="opacity-0"
  x-transition:enter-end="opacity-100"
  x-transition:leave="transition ease-in duration-100"
  x-transition:leave-start="opacity-100"
  x-transition:leave-end="opacity-0"
  class="fixed inset-0 z-40 flex items-center justify-center p-6"
>
  <div
    @click="closeSettingsModal()"
    class="absolute inset-0 bg-black/20 backdrop-blur-[3px]"
  ></div>

  <div
    class="relative w-full max-w-2xl flex flex-col z-10 max-h-[80vh] bg-popover border border-border rounded-lg overflow-hidden"
  >
    <div class="wv-header shrink-0">
      <div class="flex items-start justify-between">
        <div>
          <h2 class="text-[20px] font-display font-medium text-foreground">Settings</h2>
          <p class="wv-subtitle">Customize your workspace experience.</p>
        </div>
        <button
          @click="closeSettingsModal()"
          class="wv-close flex items-center justify-center hover:bg-accent focus-ring cursor-pointer"
        >
          <iconify-icon :icon="getIconName('x')" class="w-3.5 h-3.5"></iconify-icon>
        </button>
      </div>
    </div>

    <div
      id="modal-scroll-canvas"
      class="wv-scroll flex-1 overflow-y-auto no-scrollbar scroll-smooth"
    >
      <section id="sec-general" class="settings-section">
        <h4 class="wv-sec-h">General</h4>
        <div class="wv-field">
          <label class="wv-field-label">Workspace Name</label>
          <input type="text" x-model="workspaceNameInput" class="ghost-btn wv-btn wv-input px-3 py-1.5 text-[12px] font-medium focus-ring text-foreground" />
        </div>
      </section>

      <div class="wv-rule"></div>

      <section id="sec-members" class="settings-section">
        <h4 class="wv-sec-h">Members</h4>

        <div x-data="{ inviteUsername: '', inviteRole: 'editor', inviteExpiry: '7d', inviteLink: '', copied: false }">
          <div class="flex items-center gap-2 mb-3 flex-wrap">
            <input type="text" x-model="inviteUsername" placeholder="Username" aria-label="Username to add" class="ghost-btn wv-btn wv-input-invite px-3 py-1.5 text-[12px] focus-ring text-foreground" />
            <button class="ghost-btn wv-btn px-3 py-1.5 text-[12px] font-medium focus-ring cursor-pointer border border-border hover:bg-hover">
              <iconify-icon :icon="getIconName('user')" class="w-3.5 h-3.5"></iconify-icon>
              Add
            </button>
            <span class="text-muted-foreground text-[12px]">or</span>
            <button
              @click="inviteLink = 'workspace.app/invite/' + Math.random().toString(36).slice(2, 10); copied = false"
              class="ghost-btn wv-btn px-3 py-1.5 text-[12px] font-medium focus-ring cursor-pointer border border-border hover:bg-hover"
            >
              <iconify-icon :icon="getIconName('link')" class="w-3.5 h-3.5"></iconify-icon>
              Generate link
            </button>
            <select x-model="inviteExpiry" aria-label="Link expiry" class="ghost-btn wv-btn px-2.5 py-1 text-[12px] focus-ring text-foreground cursor-pointer">
              <option value="24h">24h</option>
              <option value="7d">7d</option>
              <option value="30d">30d</option>
              <option value="never">Never</option>
            </select>
          </div>
          <div class="flex items-center gap-2 mb-3" x-show="inviteLink !== ''" x-cloak>
            <span class="inv-link" x-text="inviteLink"></span>
            <button
              @click="copied = true; navigator.clipboard?.writeText(inviteLink)"
              aria-label="Copy invitation link"
              class="ghost-btn wv-btn px-2.5 py-1 text-[12px] font-medium focus-ring cursor-pointer"
              x-text="copied ? 'Copied' : 'Copy'"
            >Copy</button>
          </div>
          <template x-for="m in members" :key="m.email">
            <div class="wv-member-row" x-data="{ role: m.role }">
              <div class="flex items-center gap-2.5 min-w-0">
                <span class="avatar-chip" x-text="m.initials">ME</span>
                <div class="truncate">
                  <p class="text-[14px] font-medium leading-tight text-foreground" x-text="m.name"></p>
                  <p class="wv-row-meta" x-text="m.email"></p>
                </div>
              </div>
              <div class="flex items-center gap-2 shrink-0">
                <select
                  x-model="role"
                  aria-label="Member role"
                  class="wv-role-badge cursor-pointer focus-ring"
                  :class="role.toLowerCase() === 'owner' ? 'role-owner' : ''"
                >
                  <option value="owner">Owner</option>
                  <option value="editor">Editor</option>
                  <option value="member">Member</option>
                </select>
                <button class="wv-row-icon-btn" aria-label="Member actions">
                  <iconify-icon :icon="getIconName('more-fill')" class="w-4 h-4"></iconify-icon>
                </button>
              </div>
            </div>
          </template>
        </div>
      </section>

      <div class="wv-rule"></div>

      <section id="sec-schemas" class="settings-section">
        <h4 class="wv-sec-h">Schemas</h4>
        <template x-for="schema in schemas" :key="schema.id">
          <div class="wv-row">
            <div class="flex items-center gap-2 min-w-0">
              <iconify-icon :icon="getIconName(schema.id)" class="w-4 h-4 text-muted-foreground"></iconify-icon>
              <span class="wv-row-label truncate" x-text="schema.name"></span>
            </div>
            <div class="flex items-center gap-3">
              <button class="wv-btn px-2.5 py-1 text-[12px] font-medium focus-ring border border-border bg-transparent hover:bg-hover cursor-pointer">Edit</button>
            </div>
          </div>
        </template>
      </section>
    </div>
  </div>
</div>
