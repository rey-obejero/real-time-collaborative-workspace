<div
  x-show="isSearchModalOpen"
  x-transition.opacity.duration.150
  class="fixed inset-0 z-50 flex items-start justify-center p-4 pt-24"
>
  <div
    @click.outside="closeSearchModal()"
    class="absolute inset-0 bg-black/20"
  ></div>

  <div
    class="relative w-full max-w-lg z-10 bg-popover border border-border rounded-lg overflow-hidden"
  >
    <div     class="px-4 py-3 flex items-center gap-3">
      <iconify-icon :icon="getIconName('search')" class="w-4 h-4 text-muted-foreground"></iconify-icon>
      <input
        type="text"
        x-ref="searchInput"
        x-model="searchQuery"
        placeholder="Search your entries"
        class="flex-1 bg-transparent border-none outline-none text-[14px] font-medium py-1 text-foreground"
      />
      <span class="text-[12px] text-muted-foreground">Esc</span>
    </div>

    <div class="max-h-80 overflow-y-auto no-scrollbar">
      <template x-if="searchResults.length === 0">
        <div class="px-4 py-10 text-center">
          <p
            class="text-[14px] font-medium pb-1 text-muted-foreground"
          >
            No results
          </p>
          <p class="text-[12px] text-muted-foreground">
            No entries match that search.
          </p>
        </div>
      </template>
      <ul class="p-1 space-y-0.5">
        <template x-for="item in searchResults" :key="item.id">
          <li
            @click="closeSearchModal(); loadEntryToEditor(item.id)"
            class="row-item cursor-pointer"
          >
            <div class="px-3 py-2 flex items-center gap-3">
              <iconify-icon :icon="getIconName(item.type)" class="w-4 h-4 text-muted-foreground"></iconify-icon>
              <span
                class="text-[14px] font-medium truncate flex-1 text-foreground"
                x-text="item.title || 'Untitled'"
              ></span>
              <span
                class="text-[12px] text-muted-foreground"
                x-text="getSchemaName(item.type)"
              ></span>
            </div>
          </li>
        </template>
      </ul>
    </div>

    <div
      class="px-4 py-2 flex items-center justify-between text-[12px] text-muted-foreground"
    >
      <span></span>
      <span x-text="searchResults.length + ' results'">0 results</span>
    </div>
  </div>
</div>
