<aside
      class="w-80 shrink-0 flex flex-col h-full border-r border-border bg-background"
>
  <div class="px-3 pt-3 pb-2">
    <button
      @click="isLibraryDropdownOpen = !isLibraryDropdownOpen"
      class="w-full flex items-center gap-2 px-2 py-1.5 rounded-full hover:bg-accent"
    >
      <img
        src="https://api.dicebear.com/10.x/initials/svg?initialsVariant=alt:1&lettersVariant=single:0&backgroundColor=000000&textColor=ffffff&seed=Personal%20Space"
        alt="Personal Space"
        class="w-5 h-5 rounded"
      />
      <span
        class="text-[14px] font-medium text-foreground"
        x-text="currentLibrary"
        >Personal Space</span
      >
      <svg
        class="w-3 h-3 ml-auto text-muted-foreground transition"
        :class="isLibraryDropdownOpen ? 'rotate-180' : ''"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M19.5 8.25l-7.5 7.5-7.5-7.5"
        />
      </svg>
    </button>

    <div
      x-show="isLibraryDropdownOpen"
      @click.outside="isLibraryDropdownOpen = false"
      x-transition
      class="absolute z-20 mt-1 w-56 ml-3 rounded-lg border border-border bg-popover overflow-hidden"
    >
      <button
        @click="selectLibrary('Personal Space')"
        :class="currentLibrary === 'Personal Space' ? 'bg-accent' : ''"
        class="w-full text-left px-3 py-2 text-[14px] flex items-center gap-2 hover:bg-accent rounded-full"
      >
        <img
          src="https://api.dicebear.com/7.x/initials/svg?seed=Personal%20Space"
          alt="Personal Space"
          class="w-4 h-4 rounded"
        />
        <span>Personal Space</span>
      </button>
      <button
        @click="selectLibrary('Team Space')"
        :class="currentLibrary === 'Team Space' ? 'bg-accent' : ''"
        class="w-full text-left px-3 py-2 text-[14px] flex items-center gap-2 hover:bg-accent rounded-full"
      >
        <span
          class="w-4 h-4 rounded bg-foreground text-background flex items-center justify-center text-[9px] font-semibold"
          >E</span
        >
        <span>Team Space</span>
      </button>
      <button
        @click="openSettingsModal()"
        class="w-full text-left px-3 py-2 text-[14px] flex items-center gap-2 hover:bg-accent text-muted-foreground rounded-full"
      >
        <svg
          class="w-3.5 h-3.5"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.324.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 011.37.49l1.296 2.247a1.125 1.125 0 01-.26 1.43l-1.003.828c-.293.241-.438.613-.43.992a7.723 7.723 0 010 .255c-.008.378.137.75.43.991l1.004.827c.424.35.534.954.26 1.43l-1.298 2.247a1.125 1.125 0 01-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 01-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 01-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 01-1.369-.49l-1.297-2.247a1.125 1.125 0 01.26-1.43l1.004-.827c.292-.24.437-.613.43-.991a6.932 6.932 0 010-.255c.007-.38-.138-.751-.43-.992l-1.004-.827a1.125 1.125 0 01-.26-1.43l1.297-2.247a1.125 1.125 0 011.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.28z"
          />
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
          />
        </svg>
        <span>Settings</span>
      </button>
    </div>
  </div>

  <div class="px-3 pb-2 space-y-1">
    <button
      @click="openSearchModal()"
      class="ghost-btn w-full flex items-center gap-2 px-2.5 py-1.5 text-[14px] focus-ring text-muted-foreground"
    >
      <svg
        class="w-3.5 h-3.5"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"
        />
      </svg>
      <span>Search</span>
      <span class="ml-auto text-[12px] opacity-60">CTRL K</span>
    </button>
    <div class="relative" @click.outside="isNewMenuOpen = false">
      <button
        @click="isNewMenuOpen = !isNewMenuOpen"
        class="primary-btn w-full flex items-center justify-center gap-1.5 px-2.5 py-1.5 text-[14px] font-medium"
      >
        <span>Create</span>
        <svg
          class="w-3 h-3 ml-0.5 opacity-60"
          :class="isNewMenuOpen ? 'rotate-180' : ''"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M19.5 8.25l-7.5 7.5-7.5-7.5"
          />
        </svg>
      </button>

      <div
        x-show="isNewMenuOpen"
        x-transition
        class="absolute top-full left-0 right-0 mt-1 z-30 bg-popover border border-border rounded-lg overflow-hidden"
      >
        <div
          class="px-3 pt-2 pb-1 text-[12px] font-medium text-muted-foreground"
        >
          Entries
        </div>
        <template x-for="schema in schemas" :key="schema.id">
          <button
            @click="createNewEntryOfType(schema.id); isNewMenuOpen = false"
            class="w-full text-left px-3 py-1.5 text-[14px] flex items-center gap-2 hover:bg-accent text-foreground rounded-full"
          >
            <span
              x-html="getTypeIconSvg(schema.id)"
              class="w-3.5 h-3.5 flex items-center"
            ></span>
            <span x-text="schema.name"></span>
          </button>
        </template>
        <div
          class="px-3 pt-1 pb-1 text-[12px] font-medium text-muted-foreground"
        >
          Schemas
        </div>
        <button
          disabled
          class="w-full text-left px-3 py-1.5 text-[14px] flex items-center gap-2 opacity-50 cursor-not-allowed text-muted-foreground rounded-full"
        >
          <svg
            class="w-3.5 h-3.5"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 4.5v15m7.5-7.5h-15"
            />
          </svg>
          <span>New Schema</span>
          <span
            class="ml-auto text-[12px]"
            >soon</span
          >
        </button>
      </div>
    </div>
  </div>

  <div class="flex-1 overflow-y-auto no-scrollbar">
    <div class="px-3 pt-3 pb-1">
      <p
        class="text-[12px] font-medium text-muted-foreground px-2 mb-1"
      >
      Overview
      </p>
      <ul class="space-y-0.5">
        <li>
          <button
            @click="selectCollection('all')"
            :class="{ 'active': activeCollection === 'all' }"
            class="nav-row w-full flex items-center gap-2 px-2 py-2.5 text-[14px] font-medium"
          >
            <svg
              class="w-3.5 h-3.5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z"
              />
            </svg>
            <span>All</span>
            <span
              class="ml-auto text-[12px] tabular-nums opacity-70"
              x-text="totalEntryCount"
              >0</span
            >
          </button>
        </li>
        <li>
          <button
            @click="selectCollection('recent')"
            :class="{ 'active': activeCollection === 'recent' }"
            class="nav-row w-full flex items-center gap-2 px-2 py-2.5 text-[14px] font-medium"
          >
            <svg
              class="w-3.5 h-3.5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"
              />
            </svg>
            <span>Recent</span>
            <span
              class="ml-auto text-[12px] tabular-nums opacity-70"
              x-text="entries.length"
              >0</span
            >
          </button>
        </li>
        </ul>
    </div>

    <div class="px-3 pt-4 pb-1">
      <p
        class="text-[12px] font-medium text-muted-foreground px-2 mb-1"
      >
        Schemas
      </p>
      <ul class="space-y-0.5">
        <template x-for="schema in schemas" :key="schema.id">
          <li>
            <button
              @click="selectSchema(schema.id)"
              :class="{ 'active': activeSchema === schema.id }"
              class="nav-row schema-row w-full flex items-center gap-2 px-2 py-2.5 text-[14px] font-medium"
            >
              <span
                x-html="getTypeIconSvg(schema.id)"
                class="w-3.5 h-3.5 flex items-center"
              ></span>
              <span x-text="schema.name"></span>
              <span
                class="ml-auto text-[12px] tabular-nums opacity-70"
                x-text="countByType(schema.id)"
                >0</span
              >
            </button>
          </li>
        </template>
      </ul>
    </div>

    <div class="px-3 pt-4 pb-1">
      <p
        class="text-[12px] font-medium text-muted-foreground px-2 mb-1"
      >
        Archive
      </p>
      <ul class="space-y-0.5">
        <li>
          <button
            class="nav-row w-full flex items-center gap-2 px-2 py-2.5 text-[14px] font-medium"
          >
            <svg
              class="w-3.5 h-3.5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z"
              />
            </svg>
            <span>Trash</span>
          </button>
        </li>
      </ul>
    </div>
  </div>

  <div class="px-3 py-3">
    <div
      class="flex items-center gap-2 px-2 py-1.5 rounded-full hover:bg-accent cursor-pointer"
    >
      <span
        class="w-6 h-6 flex items-center justify-center rounded-full bg-secondary text-foreground text-[9px] font-semibold"
        >ME</span
      >
      <div class="min-w-0 flex-1">
        <p class="text-[14px] font-medium truncate">My Profile</p>
        <p class="text-[12px] truncate text-muted-foreground">
          john.die@example.com
        </p>
      </div>
    </div>
  </div>
</aside>
