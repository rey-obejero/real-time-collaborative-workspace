<aside
      class="w-80 shrink-0 flex flex-col h-full border-r border-border bg-background select-none"
>
  <div class="px-3 pt-3 pb-4">
    <button
      @click="isLibraryDropdownOpen = !isLibraryDropdownOpen"
      class="tweak-special tweak-action w-full flex items-center gap-2 px-2 py-1.5 rounded-full hover:bg-hover cursor-pointer"
    >
      <img
        src="https://api.dicebear.com/10.x/initials/svg?initialsVariant=alt:1&lettersVariant=single:0&backgroundColor=000000&textColor=ffffff&seed=Personal%20Space"
        alt="Personal Space"
        class="tweak-avatar w-5 h-5 rounded"
      />
      <span
        class="text-[14px] font-medium text-foreground"
        x-text="currentLibrary"
        >Personal Space</span
      >
      <span class="ml-auto text-muted-foreground transition inline-flex items-center" :class="isLibraryDropdownOpen ? 'rotate-180' : ''">
            <iconify-icon :icon="getIconName('chevron-down')" class="w-3 h-3"></iconify-icon>
          </span>
    </button>

    <div class="relative">
      <div
        x-show="isLibraryDropdownOpen"
        @click.outside="isLibraryDropdownOpen = false"
        x-transition
        class="absolute top-full left-0 right-0 mt-1 z-30 rounded-lg overflow-hidden bg-background border border-border p-1.5"
      >
        <div class="space-y-0.5">
          <button
            @click="selectLibrary('Personal Space')"
            :class="currentLibrary === 'Personal Space' ? 'bg-accent' : ''"
            class="w-full text-left px-3 py-1.5 text-[14px] flex items-center gap-2.5 hover:bg-hover rounded-lg"
          >
            <img
              src="https://api.dicebear.com/10.x/initials/svg?backgroundColor=000000&textColor=ffffff&seed=Personal%20Space"
              alt="Personal Space"
              class="tweak-avatar w-4 h-4 rounded"
            />
            <span>Personal Space</span>
          </button>
          <button
            @click="selectLibrary('Team Space')"
            :class="currentLibrary === 'Team Space' ? 'bg-accent' : ''"
            class="w-full text-left px-3 py-1.5 text-[14px] flex items-center gap-2.5 hover:bg-hover rounded-lg"
          >
            <img
              src="https://api.dicebear.com/10.x/initials/svg?backgroundColor=000000&textColor=ffffff&seed=Team%20Space"
              alt="Team Space"
              class="tweak-avatar w-4 h-4 rounded"
            />
            <span>Team Space</span>
          </button>
          <button
            @click="openSettingsModal()"
            class="w-full text-left px-3 py-1.5 text-[14px] flex items-center gap-2.5 hover:bg-hover text-muted-foreground rounded-lg"
          >
            <iconify-icon :icon="getIconName('settings')" class="w-3.5 h-3.5"></iconify-icon>
            <span>Settings</span>
          </button>
          <button
            @click="selectLibrary('New Workspace')"
            class="w-full text-left px-3 py-1.5 text-[14px] flex items-center gap-2.5 hover:bg-hover text-muted-foreground rounded-lg"
          >
            <iconify-icon :icon="getIconName('add')" class="w-3.5 h-3.5"></iconify-icon>
            <span>New Workspace</span>
          </button>
        </div>
      </div>
    </div>
  </div>



  <div class="px-3 pb-2">
    <div class="vp2-shell relative p-1" @click.outside="isNewMenuOpen = false">
      <button
        @click="openSearchModal()"
        class="vp2-row w-full flex items-center gap-2 px-2.5 py-1.5 text-[14px] focus-ring cursor-pointer"
      >
        <iconify-icon :icon="getIconName('search')" class="w-3.5 h-3.5"></iconify-icon>
        <span>Search</span>
        <span class="vp2-kbd ml-auto">Ctrl K</span>
      </button>
      <div class="vp2-divider h-px my-1"></div>
      <button
        @click="isNewMenuOpen = !isNewMenuOpen"
        class="vp2-row w-full flex items-center gap-2 px-2.5 py-1.5 text-[14px] cursor-pointer"
      >
        <iconify-icon :icon="getIconName('add')" class="w-3.5 h-3.5"></iconify-icon>
        <span>Create</span>
        <span class="ml-auto transition inline-flex items-center" :class="isNewMenuOpen ? 'rotate-180' : ''">
          <iconify-icon :icon="getIconName('chevron-down')" class="w-3.5 h-3.5"></iconify-icon>
        </span>
      </button>
      <div
        x-show="isNewMenuOpen"
        x-transition
        class="absolute top-full left-0 right-0 mt-1 z-30 rounded-lg overflow-hidden bg-background border border-border p-1.5"
      >
        <div class="space-y-0.5">
          <template x-for="schema in schemas" :key="schema.id">
            <button
              @click="createNewEntryOfType(schema.id); isNewMenuOpen = false"
              class="w-full text-left px-3 py-1.5 text-[14px] flex items-center gap-2.5 hover:bg-hover text-foreground rounded-lg"
            >
              <iconify-icon :icon="getIconName(schema.id)" class="w-3.5 h-3.5"></iconify-icon>
              <span x-text="schema.name"></span>
            </button>
          </template>
        </div>
        <div class="pt-2 space-y-0.5">
          <button class="w-full text-left px-3 py-1.5 text-[14px] flex items-center gap-2.5 hover:bg-hover text-muted-foreground rounded-lg">
            <iconify-icon :icon="getIconName('grid')" class="w-3.5 h-3.5"></iconify-icon>
            <span>New Collection</span>
          </button>
          <button class="w-full text-left px-3 py-1.5 text-[14px] flex items-center gap-2.5 hover:bg-hover text-muted-foreground rounded-lg">
            <iconify-icon :icon="getIconName('add')" class="w-3.5 h-3.5"></iconify-icon>
            <span>New Schema</span>
          </button>
        </div>
      </div>
    </div>
  </div>



  <div class="flex-1 overflow-y-auto no-scrollbar">
    <div class="px-3 pt-3 pb-1">
      <p class="text-[12px] font-medium text-muted-foreground px-2 mb-1">Overview</p>
      <ul class="space-y-0.5">
        <li>
          <button @click="selectCollection('pinned')" :class="{ 'active': activeCollection === 'pinned' }" class="tweak-action nav-row w-full flex items-center gap-2 px-2 py-3 text-[14px] font-medium">
            <iconify-icon :icon="getIconName('pin')" class="tweak-icon w-3.5 h-3.5"></iconify-icon>
            <span>Pinned</span>
          </button>
        </li>
        <li>
          <button @click="selectCollection('recent')" :class="{ 'active': activeCollection === 'recent' }" class="tweak-action nav-row w-full flex items-center gap-2 px-2 py-3 text-[14px] font-medium">
            <iconify-icon :icon="getIconName('clock')" class="tweak-icon w-3.5 h-3.5"></iconify-icon>
            <span>Recent</span>
          </button>
        </li>
        <li>
          <button @click="selectCollection('all')" :class="{ 'active': activeCollection === 'all' }" class="tweak-action nav-row w-full flex items-center gap-2 px-2 py-3 text-[14px] font-medium">
            <iconify-icon :icon="getIconName('grid')" class="tweak-icon w-3.5 h-3.5"></iconify-icon>
            <span>All</span>
          </button>
        </li>
      </ul>
    </div>

    <div class="px-3 pt-4 pb-1">
      <p class="text-[12px] font-medium text-muted-foreground px-2 mb-1">Collections</p>
      <ul class="space-y-0.5">
        <li>
          <button class="tweak-action nav-row w-full flex items-center gap-2 px-2 py-3 text-[14px] font-medium">
            <iconify-icon :icon="getIconName('user')" class="tweak-icon w-3.5 h-3.5"></iconify-icon>
            <span>Personal</span>
          </button>
        </li>
        <li>
          <button class="tweak-action nav-row w-full flex items-center gap-2 px-2 py-3 text-[14px] font-medium">
            <iconify-icon :icon="getIconName('briefcase')" class="tweak-icon w-3.5 h-3.5"></iconify-icon>
            <span>Work</span>
          </button>
        </li>
      </ul>
    </div>

    <div class="px-3 pt-4 pb-1">
      <p class="text-[12px] font-medium text-muted-foreground px-2 mb-1">Schemas</p>
      <ul class="space-y-0.5">
        <template x-for="schema in schemas" :key="schema.id">
          <li>
            <button @click="selectSchema(schema.id)" :class="{ 'active': activeSchema === schema.id }" class="tweak-action nav-row schema-row w-full flex items-center gap-2 px-2 py-2.5 text-[14px] font-medium">
              <iconify-icon :icon="getIconName(schema.id)" class="tweak-icon w-3.5 h-3.5"></iconify-icon>
              <span x-text="schema.name"></span>
            </button>
          </li>
        </template>
      </ul>
    </div>

    <div class="pt-4 pb-1">
      <ul class="space-y-0.5">
        <li>
          <button @click="selectConversations()" :class="{ 'active': activeView === 'conversations' }" class="tweak-action nav-row w-full flex items-center gap-2 px-2 py-3 text-[14px] font-medium">
            <iconify-icon :icon="getIconName('chat')" class="tweak-icon w-3.5 h-3.5"></iconify-icon>
            <span class="conv-text">Conversations</span>
            <span x-show="hasUnreadDiscussions" class="status-dot ml-auto" style="background: var(--foreground)"></span>
          </button>
        </li>
      </ul>
    </div>

    <div class="pt-3 pb-1">
      <ul class="space-y-0.5">
        <li>
          <button class="tweak-action nav-row w-full flex items-center gap-2 px-2 py-3 text-[14px] font-medium">
            <iconify-icon :icon="getIconName('help-circle')" class="tweak-icon w-3.5 h-3.5"></iconify-icon>
            <span>Help</span>
          </button>
        </li>
        <li>
          <button class="tweak-action nav-row w-full flex items-center gap-2 px-2 py-3 text-[14px] font-medium">
            <iconify-icon :icon="getIconName('trash')" class="tweak-icon w-3.5 h-3.5"></iconify-icon>
            <span>Trash</span>
          </button>
        </li>
      </ul>
    </div>
  </div>

  <div class="px-3 py-3">
    <div
      class="tweak-special tweak-action flex items-center gap-2 px-2 py-1.5 rounded-full hover:bg-hover cursor-pointer"
    >
      <img
        src="https://api.dicebear.com/10.x/initials/svg?initialsVariant=alt:1&lettersVariant=single:0&backgroundColor=000000&textColor=ffffff&seed=My%20Profile"
        alt="My Profile"
        class="tweak-avatar w-6 h-6 rounded"
      />
      <div class="min-w-0 flex-1">
        <p class="text-[14px] font-medium truncate">My Profile</p>
      </div>
      <iconify-icon :icon="getIconName('settings')" class="tweak-icon w-3.5 h-3.5"></iconify-icon>
    </div>
  </div>
</aside>