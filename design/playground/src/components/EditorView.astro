<div
  x-show="activeView === 'editor'"
  class="flex-1 flex flex-col h-full overflow-hidden"
>
  <div
    class="h-12 px-6 flex items-center justify-between shrink-0"
  >
    <button
      @click="exitToListView()"
      class="flex items-center gap-1 text-[14px] hover:text-foreground text-muted-foreground rounded-full px-2 py-1 hover:bg-secondary"
    >
      <iconify-icon :icon="getIconName('chevron-left')" class="w-3 h-3"></iconify-icon>
      <span>Back</span>
    </button>
    <div class="flex items-center gap-3 text-[12px] text-muted-foreground">
      <span class="flex items-center gap-1.5" x-show="activeEntry">
        <iconify-icon :icon="getIconName(activeEntry?.type || 'page')" class="w-3.5 h-3.5 text-muted-foreground"></iconify-icon>
        <span
          class="capitalize"
          x-text="getSchemaName(activeEntry?.type)"
        ></span>
      </span>
      <span x-text="formatDate(new Date())"></span>
      <span
        class="flex items-center gap-1.5"
        x-show="activeView === 'editor'"
        x-transition.opacity
      >
        <span
          class="status-dot"
          :style="syncStatus === 'Saving...' ? 'background: var(--muted-foreground)' : 'background: var(--foreground)'"
        ></span>
        <span
          x-text="syncStatus"
        ></span>
      </span>
    </div>
  </div>

  <div
    class="flex-1 overflow-y-auto no-scrollbar"
    @click="handleEditorClick($event)"
  >
    <div class="max-w-2xl w-full mx-auto px-8 py-8">
      <div class="space-y-4 pb-6">
        <div
          class="flex items-center gap-2 text-[12px] font-medium text-muted-foreground"
        >
          <span
            x-text="getSchemaName(activeEntry?.type) + ' · ' + getSchemaSubtitle(activeEntry?.type)"
          ></span>
        </div>

        <input
          type="text"
          x-model="editorTitle"
          @input="syncEditorTitle()"
          placeholder="Untitled"
          class="w-full text-[30px] leading-[1.2] font-medium bg-transparent border-none outline-none text-foreground font-display"
        />

        <div
          class="flex flex-wrap items-center gap-2 pt-1"
          x-show="activeEntry"
        >
          <template x-if="activeEntry?.status">
            <div class="property-chip">
              <span class="label">Status</span>
              <span
                class="status-dot"
                :style="'background: var(--status-' + activeEntry.status + ')'"
              ></span>
              <span
                class="value capitalize"
                x-text="activeEntry.status"
              ></span>
            </div>
          </template>

          <template x-if="activeEntry?.priority">
            <div class="property-chip">
              <span class="label">Priority</span>
              <span
                class="value capitalize"
                x-text="activeEntry.priority"
              ></span>
            </div>
          </template>

          <template x-if="activeEntry?.due">
            <div class="property-chip">
              <span class="label">Due</span>
              <span class="value capitalize" x-text="activeEntry.due"></span>
            </div>
          </template>

          <template x-if="activeEntry?.start && activeEntry?.end">
            <div class="property-chip">
              <span class="label">Timeline</span>
              <span
                class="value"
                x-text="activeEntry.start + ' → ' + activeEntry.end"
              ></span>
            </div>
          </template>

          <template x-if="activeEntry?.url">
            <div class="property-chip">
              <span class="label">URL</span>
              <span
                class="value text-[12px] truncate max-w-[200px]"
                x-text="activeEntry.url"
              ></span>
            </div>
          </template>

          <template x-if="activeEntry?.assignee">
            <div class="property-chip">
              <span class="label">Assignee</span>
              <span
                class="avatar-chip"
                x-text="(activeEntry.assignee || '?').slice(0, 2).toUpperCase()"
              ></span>
            </div>
          </template>

          <template x-if="activeEntry?.owner">
            <div class="property-chip">
              <span class="label">Owner</span>
              <span
                class="avatar-chip"
                x-text="(activeEntry.owner || '?').slice(0, 2).toUpperCase()"
              ></span>
            </div>
          </template>

          <template
            x-if="activeEntry?.tags && activeEntry.tags.length > 0"
          >
            <div class="property-chip">
              <span class="label">Tags</span>
              <template x-for="tag in activeEntry.tags" :key="tag">
                <span class="tag-pill" x-text="'#' + tag"></span>
              </template>
            </div>
          </template>
        </div>

        <div
          x-show="activeEditorSection === 'docs'"
          class="text-[14px] text-muted-foreground pt-1"
        >
          Documents (0)
        </div>
      </div>

      <div class="relative pt-6">
        <div
          id="editor-content-body"
          contenteditable="true"
          spellcheck="false"
          @input="syncEditorContent()"
          @keyup="handleEditorKeyUp($event)"
          @mouseup="handleSelectionChange($event)"
          class="prose-readable w-full bg-transparent border-none outline-none text-foreground"
        ></div>
      </div>
    </div>
  </div>
</div>
