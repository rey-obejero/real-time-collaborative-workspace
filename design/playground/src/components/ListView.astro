<div
  x-show="activeView === 'list'"
  class="flex-1 flex flex-col h-full overflow-y-auto no-scrollbar"
>
  <div class="w-[85%] mx-auto px-8 py-8">
    <div class="tweak-card border border-border rounded-t-lg overflow-hidden">
      <div class="flex items-center justify-between pl-4 pr-4 py-2">
        <div class="flex items-baseline gap-1.5">
          <h1
            class="text-[20px] font-medium font-display text-foreground"
            x-text="headerCrumb"
          >
            All
          </h1>
        </div>
        <div class="flex items-center gap-1">
          <button class="header-btn w-7 h-7 flex items-center justify-center rounded-[7px] text-muted-foreground hover:bg-hover hover:text-foreground cursor-pointer" title="Search">
            <iconify-icon :icon="getIconName('search')" class="w-3.5 h-3.5"></iconify-icon>
            <span class="header-tooltip">Search</span>
          </button>
          <button class="header-btn w-7 h-7 flex items-center justify-center rounded-[7px] text-muted-foreground hover:bg-hover hover:text-foreground cursor-pointer" title="Filter">
            <iconify-icon :icon="getIconName('filter')" class="w-3.5 h-3.5"></iconify-icon>
            <span class="header-tooltip">Filter</span>
          </button>
          <button class="header-btn w-7 h-7 flex items-center justify-center rounded-[7px] text-muted-foreground hover:bg-hover hover:text-foreground cursor-pointer" title="Sort">
            <iconify-icon :icon="getIconName('sort')" class="w-3.5 h-3.5"></iconify-icon>
            <span class="header-tooltip">Sort</span>
          </button>
          <button @click="openSettingsModal()" class="header-btn w-7 h-7 flex items-center justify-center rounded-[7px] text-muted-foreground hover:bg-hover hover:text-foreground cursor-pointer" title="Settings">
            <iconify-icon :icon="getIconName('settings-codicon')" class="w-3.5 h-3.5"></iconify-icon>
            <span class="header-tooltip">Settings</span>
          </button>
          <div class="bg-primary flex items-center overflow-hidden rounded-[7px]">
            <button
              @click="createNewEntryOfType()"
              class="flex items-center gap-1 pl-3 pr-1 h-7 text-[12px] font-medium text-primary-foreground cursor-pointer hover:bg-primary-foreground/25"
            >
              <span class="text-[14px] leading-none">+</span>
              <span>New</span>
            </button>
            <button
              class="w-7 h-7 flex items-center justify-center text-primary-foreground/75 cursor-pointer hover:bg-primary-foreground/25"
              title="New options"
            >
              <iconify-icon :icon="getIconName('chevron-down')" class="w-3.5 h-3.5"></iconify-icon>
            </button>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-[1fr_120px_140px_80px] items-center pl-4 pr-4 py-2 border-t border-b border-border">
        <div class="pr-3 text-[12px] font-medium text-muted-foreground">Title</div>
        <div class="pr-3 text-[12px] font-medium text-muted-foreground">Status</div>
        <div class="pr-3 text-[12px] font-medium text-muted-foreground">Tags</div>
        <div class="text-[12px] font-medium text-muted-foreground text-right">Updated</div>
      </div>

      <template x-if="filteredEntries.length === 0">
        <div class="px-6 py-12 text-center">
          <p class="text-[12px] pb-1 text-muted-foreground">No entries</p>
          <p class="text-[12px] text-muted-foreground">This set is currently empty.</p>
        </div>
      </template>

      <template x-if="filteredEntries.length > 0">
        <ul class="m-0 p-0 list-none">
          <template x-for="item in filteredEntries" :key="item.id">
            <li
              class="cursor-pointer hover:bg-accent"
              :class="currentSelectedId === item.id ? 'bg-accent' : ''"
              @click="loadEntryToEditor(item.id)"
            >
              <div
                class="grid grid-cols-[1fr_120px_140px_80px] items-center pl-4 pr-4 py-2"
                :class="{ 'border-b border-border': !tweaks.tableStyle || tweaks.tableStyle === 'default' || tweaks.tableStyle === 'grid' }"
              >
                <span
                  class="pr-3 flex items-center gap-2 min-w-0"
                  :class="{ 'border-r border-border': tweaks.tableStyle === 'divided' || tweaks.tableStyle === 'grid' }"
                >
                  <iconify-icon :icon="getIconName(item.type)" class="w-4 h-4 text-muted-foreground shrink-0"></iconify-icon>
                  <span
                    class="text-[14px] truncate text-table-entry"
                    x-text="item.title || 'Untitled'"
                  ></span>
                </span>
                <span
                  class="pr-3 text-[12px] flex items-center gap-1.5 text-table-entry"
                  :class="{ 'border-r border-border': tweaks.tableStyle === 'divided' || tweaks.tableStyle === 'grid' }"
                  x-show="item.status"
                >
                  <span
                    class="status-dot w-2 h-2 rounded-full shrink-0"
                    :style="'background: var(--status-' + item.status + ')'"
                  ></span>
                  <span
                    class="capitalize"
                    x-text="item.status"
                  ></span>
                </span>
                <div
                  class="pr-3 flex items-center gap-1 overflow-hidden"
                  :class="{ 'border-r border-border': tweaks.tableStyle === 'divided' || tweaks.tableStyle === 'grid' }"
                >
                  <template
                    x-for="tag in (item.tags || []).slice(0, 2)"
                    :key="tag"
                  >
                    <span class="tag-pill inline-flex items-center px-2 py-0.5 text-[12px] text-table-entry bg-secondary rounded-full" x-text="'#' + tag"></span>
                  </template>
                  <template x-if="(item.tags || []).length > 2">
                    <span
                      class="text-[12px] text-table-entry"
                      x-text="'+' + (item.tags.length - 2)"
                    ></span>
                  </template>
                </div>
                <span
                  class="text-[12px] tabular-nums text-right text-table-entry"
                  :class="{ 'border-r border-border': tweaks.tableStyle === 'divided' || tweaks.tableStyle === 'grid' }"
                  x-text="formatRelativeTime(item.updatedAt)"
                ></span>
              </div>
            </li>
          </template>
          <li class="cursor-pointer" @click="createNewEntryOfType()">
            <div
              class="grid grid-cols-[1fr_120px_140px_80px] items-center pl-4 pr-4 py-2 text-table-entry hover:bg-accent"
              :class="{ 'border-b border-border': !tweaks.tableStyle || tweaks.tableStyle === 'default' || tweaks.tableStyle === 'grid' }"
            >
              <span
                class="pr-3 flex items-center gap-2 min-w-0"
                :class="{ 'border-r border-border': tweaks.tableStyle === 'divided' || tweaks.tableStyle === 'grid' }"
              >
                <span class="text-[14px] leading-none">+</span>
                <span class="text-[14px]">New entry</span>
              </span>
              <div
                class="pr-3"
                :class="{ 'border-r border-border': tweaks.tableStyle === 'divided' || tweaks.tableStyle === 'grid' }"
              ></div>
              <div
                class="pr-3"
                :class="{ 'border-r border-border': tweaks.tableStyle === 'divided' || tweaks.tableStyle === 'grid' }"
              ></div>
              <div
                :class="{ 'border-r border-border': tweaks.tableStyle === 'divided' || tweaks.tableStyle === 'grid' }"
              ></div>
            </div>
          </li>
        </ul>
      </template>
    </div>
  </div>
</div>
