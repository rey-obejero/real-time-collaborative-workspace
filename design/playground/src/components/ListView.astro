---
import Icon from "./Icon.astro";
---
<div
  x-show="activeView === 'list'"
  class="flex-1 flex flex-col h-full overflow-y-auto no-scrollbar"
>
  <div class="w-full px-8 py-8">
    <div class="flex items-end justify-between mb-6">
      <div>
        <h1
          class="text-[24px] leading-[1.33] font-semibold font-display text-foreground"
          x-text="listHeaderTitle"
        >
          All
        </h1>
        <p
          class="text-[14px] mt-1 text-muted-foreground"
          x-text="listHeaderSubtitle"
        >
          All entries across schemas
        </p>
      </div>
      <div class="flex items-center gap-1">
        <button
          class="ghost-btn flex items-center gap-1.5 px-2.5 py-1 text-[14px] font-medium"
        >
          <Icon name="sort" class="w-3 h-3" />
          <span>Sort</span>
        </button>
        <button
          class="ghost-btn flex items-center gap-1.5 px-2.5 py-1 text-[14px] font-medium"
        >
          <Icon name="filter" class="w-3 h-3" />
          <span>Filter</span>
        </button>
      </div>
    </div>

      <div class="tweak-card border border-border rounded-lg overflow-hidden bg-card">
      <div
        class="grid grid-cols-[20px_1fr_120px_140px_80px] items-center gap-3 px-3 py-2 bg-secondary"
      >
        <div></div>
        <div
          class="text-[12px] font-medium text-muted-foreground"
        >
          Title
        </div>
        <div
          class="text-[12px] font-medium text-muted-foreground"
        >
          Status
        </div>
        <div
          class="text-[12px] font-medium text-muted-foreground"
        >
          Tags
        </div>
        <div
          class="text-[12px] font-medium text-muted-foreground text-right"
        >
          Updated
        </div>
      </div>

      <template x-if="filteredEntries.length === 0">
        <div class="px-6 py-12 text-center">
          <p
            class="text-[12px] pb-1 text-muted-foreground"
          >
            No entries
          </p>
          <p class="text-[12px] text-muted-foreground">
            This set is currently empty.
          </p>
        </div>
      </template>

      <ul>
        <template x-for="item in filteredEntries" :key="item.id">
          <li
            class="row-item cursor-pointer"
            :class="{ 'active': currentSelectedId === item.id }"
            @click="loadEntryToEditor(item.id)"
          >
            <div
              class="grid grid-cols-[20px_1fr_120px_140px_80px] items-center gap-3 px-3 py-2 border-b border-border last:border-b-0"
            >
              <iconify-icon x-show="tweaks.iconSet !== 'custom'" :icon="getIconName(item.type)" class="w-4 h-4 text-muted-foreground"></iconify-icon>
              <span x-show="tweaks.iconSet === 'custom'" x-html="getCustomIconSvg(item.type)" class="inline-flex items-center w-4 h-4 text-muted-foreground"></span>
              <span
                class="text-[14px] font-medium truncate text-foreground"
                x-text="item.title || 'Untitled'"
              ></span>
              <span
                class="text-[12px] flex items-center gap-1.5 text-muted-foreground"
                x-show="item.status"
              >
              <span
                class="status-dot"
                :style="`background: var(--status-${item.status})`"
              ></span>
              <span
                class="status-label-only"
                :style="`background: var(--status-${item.status})`"
                x-text="item.status"
              ></span>
              <span class="capitalize" x-text="item.status"></span>
              </span>
              <span
                class="text-[12px] flex items-center gap-1 truncate text-muted-foreground"
                x-show="!item.status"
              ></span>
              <div class="flex items-center gap-1 overflow-hidden">
                <template
                  x-for="tag in (item.tags || []).slice(0, 2)"
                  :key="tag"
                >
                  <span class="tag-pill" x-text="`#${tag}`"></span>
                </template>
                <template x-if="(item.tags || []).length > 2">
                  <span
                    class="text-[12px] text-muted-foreground"
                    x-text="`+${item.tags.length - 2}`"
                  ></span>
                </template>
              </div>
              <span
                class="text-[12px] tabular-nums text-right text-muted-foreground"
                x-text="formatRelativeTime(item.updatedAt)"
              ></span>
            </div>
          </li>
        </template>
      </ul>
    </div>

    <button
      @click="createNewEntryOfType()"
      class="ghost-btn mt-3 w-full flex items-center justify-center gap-2 py-2 text-[14px] font-medium focus-ring"
    >
      <span class="text-[14px]">+</span>
      <span>New entry</span>
    </button>
  </div>
</div>
