<div
  x-show="activeView === 'list'"
  class="flex-1 flex flex-col h-full overflow-y-auto no-scrollbar"
>
  <div class="w-full px-8 py-8">

    <div class="flex items-center justify-between mb-4">
      <div class="flex items-baseline gap-1.5">
        <h1
          class="text-[20px] font-medium font-display text-foreground"
          x-text="headerCrumb"
        >
          All
        </h1>
      </div>
      <div class="flex items-center gap-1.5">
        <button class="lv-icon w-7 h-7 flex items-center justify-center focus-ring" title="Search">
          <iconify-icon :icon="getIconName('search')" class="w-3.5 h-3.5"></iconify-icon>
        </button>
        <button class="lv-icon w-7 h-7 flex items-center justify-center focus-ring" title="Filter">
          <iconify-icon :icon="getIconName('filter')" class="w-3.5 h-3.5"></iconify-icon>
        </button>
        <button class="lv-icon w-7 h-7 flex items-center justify-center focus-ring" title="Sort">
          <iconify-icon :icon="getIconName('sort')" class="w-3.5 h-3.5"></iconify-icon>
        </button>
        <button class="lv-icon w-7 h-7 flex items-center justify-center focus-ring" title="Settings">
          <iconify-icon :icon="getIconName('settings')" class="w-3.5 h-3.5"></iconify-icon>
        </button>
        <div class="new-pill flex items-center overflow-hidden rounded-[7px]">
          <button
            @click="createNewEntryOfType()"
            class="new-label flex items-center gap-1 pl-3 pr-1 h-7 text-[12px] font-medium"
          >
            <span class="text-[14px] leading-none">+</span>
            <span>New</span>
          </button>
          <button
            class="new-chevron w-7 h-7 flex items-center justify-center"
            title="New options"
          >
            <iconify-icon :icon="getIconName('chevron-down')" class="w-3.5 h-3.5"></iconify-icon>
          </button>
        </div>
      </div>
      </div>
    </div>


    <div class="tweak-card border border-border rounded-lg overflow-hidden bg-card">
      <div class="grid grid-cols-[20px_1fr_120px_140px_80px] items-center pl-3 pr-3 py-2">
        <div class="pr-3"></div>
        <div class="pr-3 text-[12px] font-medium text-muted-foreground">Title</div>
        <div class="pr-3 text-[12px] font-medium text-muted-foreground">Status</div>
        <div class="pr-3 text-[12px] font-medium text-muted-foreground">Tags</div>
        <div class="text-[12px] font-medium text-muted-foreground text-right">Updated</div>
      </div>

      <template x-if="filteredEntries.length === 0">
        <div class="px-6 py-12 text-center">
          <p class="text-[12px] pb-1 text-muted-foreground">No entries</p>
          <p class="text-[12px] text-muted-foreground">This set is currently empty.</p>
        </div>
      </template>

      <template x-if="filteredEntries.length > 0">
        <ul>
          <template x-for="item in filteredEntries" :key="item.id">
            <li
              class="row-item cursor-pointer"
              :class="{ 'active': currentSelectedId === item.id }"
              @click="loadEntryToEditor(item.id)"
            >
              <div
                class="grid grid-cols-[20px_1fr_120px_140px_80px] items-center pl-3 pr-3 py-2"
                :class="{ 'border-b border-border': !tweaks.tableStyle || tweaks.tableStyle === 'default' || tweaks.tableStyle === 'grid' }"
              >
                <span
                  class="pr-3 inline-flex items-center"
                  :class="{ 'border-r border-border': tweaks.tableStyle === 'divided' || tweaks.tableStyle === 'grid' }"
                >
                  <iconify-icon :icon="getIconName(item.type)" class="w-4 h-4 text-muted-foreground"></iconify-icon>
                </span>
                <span
                  class="pr-3 text-[14px] font-medium truncate text-foreground"
                  :class="{ 'border-r border-border': tweaks.tableStyle === 'divided' || tweaks.tableStyle === 'grid' }"
                  x-text="item.title || 'Untitled'"
                ></span>
                <span
                  class="pr-3 text-[12px] flex items-center gap-1.5 text-muted-foreground"
                  :class="{ 'border-r border-border': tweaks.tableStyle === 'divided' || tweaks.tableStyle === 'grid' }"
                  x-show="item.status"
                >
                  <span
                    class="status-dot"
                    :style="'background: var(--status-' + item.status + ')'"
                  ></span>
                  <span
                    class="capitalize"
                    x-text="item.status"
                  ></span>
                </span>
                <div
                  class="pr-3 flex items-center gap-1 overflow-hidden"
                  :class="{ 'border-r border-border': tweaks.tableStyle === 'divided' || tweaks.tableStyle === 'grid' }"
                >
                  <template
                    x-for="tag in (item.tags || []).slice(0, 2)"
                    :key="tag"
                  >
                    <span class="tag-pill" x-text="'#' + tag"></span>
                  </template>
                  <template x-if="(item.tags || []).length > 2">
                    <span
                      class="text-[12px] text-muted-foreground"
                      x-text="'+' + (item.tags.length - 2)"
                    ></span>
                  </template>
                </div>
                <span
                  class="text-[12px] tabular-nums text-right text-muted-foreground"
                  :class="{ 'border-r border-border': tweaks.tableStyle === 'divided' || tweaks.tableStyle === 'grid' }"
                  x-text="formatRelativeTime(item.updatedAt)"
                ></span>
              </div>
            </li>
          </template>
          <li class="cursor-pointer" @click="createNewEntryOfType()">
            <div
              class="grid grid-cols-[20px_1fr_120px_140px_80px] items-center pl-3 pr-3 py-2 text-muted-foreground hover:text-foreground hover:bg-accent"
              :class="{ 'border-b border-border': !tweaks.tableStyle || tweaks.tableStyle === 'default' || tweaks.tableStyle === 'grid' }"
            >
              <span
                class="pr-3 inline-flex items-center"
                :class="{ 'border-r border-border': tweaks.tableStyle === 'divided' || tweaks.tableStyle === 'grid' }"
              >
                <iconify-icon :icon="getIconName('plus')" class="w-4 h-4"></iconify-icon>
              </span>
              <span
                class="pr-3 text-[14px] font-medium"
                :class="{ 'border-r border-border': tweaks.tableStyle === 'divided' || tweaks.tableStyle === 'grid' }"
              >New entry</span>
              <div
                class="pr-3"
                :class="{ 'border-r border-border': tweaks.tableStyle === 'divided' || tweaks.tableStyle === 'grid' }"
              ></div>
              <div
                class="pr-3"
                :class="{ 'border-r border-border': tweaks.tableStyle === 'divided' || tweaks.tableStyle === 'grid' }"
              ></div>
              <div
                :class="{ 'border-r border-border': tweaks.tableStyle === 'divided' || tweaks.tableStyle === 'grid' }"
              ></div>
            </div>
          </li>
        </ul>
      </template>
    </div>
  </div>
</div>
