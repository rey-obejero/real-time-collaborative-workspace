<div
  id="floating-format-menu"
  class="absolute z-50 px-1 py-1 flex items-center gap-0.5 select-none bg-popover border border-border rounded-lg"
>
  <button
    @click="formatSelection('bold')"
    class="w-7 h-7 flex items-center justify-center text-[12px] font-semibold rounded-full hover:bg-secondary text-foreground"
  >
    B
  </button>
  <button
    @click="formatSelection('italic')"
    class="w-7 h-7 flex items-center justify-center text-[12px] italic rounded-full hover:bg-secondary text-foreground"
  >
    I
  </button>
  <button
    @click="formatSelection('strikeThrough')"
    class="w-7 h-7 flex items-center justify-center text-[12px] line-through rounded-full hover:bg-secondary text-foreground"
  >
    S
  </button>
  <button
    @click="formatSelection('code')"
    class="w-7 h-7 flex items-center justify-center text-[10px] font-mono rounded-full hover:bg-secondary text-foreground"
  >
    &lt;/&gt;
  </button>
  <div class="w-px h-4 bg-border mx-1"></div>
  <button
    @click="createDiscussionFromSelection()"
    class="px-2.5 h-7 flex items-center gap-1 text-[12px] font-medium rounded-full hover:bg-secondary text-foreground"
  >
    <iconify-icon :icon="getIconName('discuss')" class="w-3 h-3"></iconify-icon>
    <span>Discuss</span>
  </button>
</div>
