<div
  id="floating-format-menu"
  class="absolute z-50 px-1 py-1 flex items-center gap-0.5 select-none bg-popover border border-border rounded-md"
>
  <button
    @click="formatSelection('bold')"
    class="w-7 h-7 flex items-center justify-center text-[12px] font-semibold rounded hover:bg-accent text-foreground"
  >
    B
  </button>
  <button
    @click="formatSelection('italic')"
    class="w-7 h-7 flex items-center justify-center text-[12px] italic rounded hover:bg-accent text-foreground"
  >
    I
  </button>
  <button
    @click="formatSelection('strikeThrough')"
    class="w-7 h-7 flex items-center justify-center text-[12px] line-through rounded hover:bg-accent text-foreground"
  >
    S
  </button>
  <button
    @click="formatSelection('code')"
    class="w-7 h-7 flex items-center justify-center text-[10px] font-mono rounded hover:bg-accent text-foreground"
  >
    &lt;/&gt;
  </button>
  <div class="w-px h-4 bg-border mx-0.5"></div>
  <button
    @click="createDiscussionFromSelection()"
    class="px-2.5 h-7 flex items-center gap-1 text-[11px] font-medium rounded hover:bg-accent text-foreground"
  >
    <svg
      class="w-3 h-3"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      viewBox="0 0 24 24"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M7.5 8.25h9m-9 3H12"
      />
    </svg>
    <span>Discuss</span>
  </button>
</div>
