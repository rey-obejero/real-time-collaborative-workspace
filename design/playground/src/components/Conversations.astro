<section
  :class="isRightRailOpen ? 'w-80 shrink-0' : 'w-0 shrink-0'"
  class="overflow-hidden"
  style="transition: width 0.15s ease"
>
  <div
    class="w-80 h-full flex flex-col border-l border-border bg-background overflow-hidden"
  >
    <div
      class="h-14 px-3 flex items-center justify-between shrink-0"
    >
      <div class="flex items-center gap-1 p-1 bg-secondary rounded-full">
        <button
          @click="rightRailMode = 'conversations'"
          :class="rightRailMode === 'conversations' ? 'bg-foreground text-background' : 'text-muted-foreground hover:text-foreground'"
          class="px-3 py-1 text-[12px] font-medium rounded-full"
        >
          Conversations
        </button>
        <button
          @click="rightRailMode = 'properties'"
          :class="rightRailMode === 'properties' ? 'bg-foreground text-background' : 'text-muted-foreground hover:text-foreground'"
          class="px-3 py-1 text-[12px] font-medium rounded-full"
        >
          Properties
        </button>
      </div>
      <button
        @click="closeRightRail()"
        class="w-7 h-7 flex items-center justify-center rounded-full hover:bg-secondary focus-ring"
      >
        <iconify-icon :icon="getIconName('x')" class="w-3.5 h-3.5"></iconify-icon>
      </button>
    </div>

    <template x-if="rightRailMode === 'conversations'">
      <div class="flex-1 flex flex-col overflow-hidden">
        <template x-if="selectedDiscussionId === null">
          <div class="flex-1 overflow-y-auto no-scrollbar">
            <p
              class="text-[12px] font-medium px-5 py-3 text-muted-foreground"
            >
              Active
            </p>
            <ul class="px-2 space-y-0.5">
              <template x-for="chat in discussions" :key="chat.id">
                <li
                  class="row-item cursor-pointer"
                  @click="selectedDiscussionId = chat.id"
                >
                  <div class="px-3 py-2.5">
                    <div class="flex items-baseline justify-between mb-1">
                      <span
                        class="text-[14px] font-medium leading-[1.5] text-foreground"
                        x-text="chat.title"
                      ></span>
                      <span class="status-dot" style="background: var(--muted-foreground)"></span>
                    </div>
                    <p
                      class="text-[12px] truncate leading-[1.5] text-muted-foreground"
                      x-text="chat.preview"
                    ></p>
                  </div>
                </li>
              </template>
            </ul>
          </div>
        </template>

        <template x-if="selectedDiscussionId !== null">
          <div class="flex-1 flex flex-col overflow-hidden">
            <div
              class="px-5 py-2 flex items-center gap-2 shrink-0"
            >
              <button
                @click="selectedDiscussionId = null"
                class="w-7 h-7 flex items-center justify-center rounded-full hover:bg-secondary focus-ring"
              >
                <iconify-icon :icon="getIconName('chevron-left')" class="w-3.5 h-3.5"></iconify-icon>
              </button>
              <span
                class="text-[14px] font-medium truncate"
                x-text="activeDiscussion ? activeDiscussion.title : ''"
              ></span>
            </div>

            <div
              id="messages-canvas"
              class="flex-1 overflow-y-auto no-scrollbar px-5 py-4 space-y-4"
            >
              <template
                x-for="(msg, idx) in (activeDiscussion ? activeDiscussion.messages : [])"
                :key="idx"
              >
                <div
                  :class="msg.sender === 'Me' ? 'flex flex-col items-end' : 'space-y-1'"
                >
                  <p
                    class="text-[12px] font-medium mb-1 text-muted-foreground"
                    x-text="msg.sender === 'Me' ? 'You' : msg.sender"
                  ></p>
                  <p
                    class="text-[12px] leading-relaxed max-w-[85%]"
                    :class="msg.sender === 'Me' ? 'px-3 py-1.5 rounded-lg bg-foreground text-background' : 'text-foreground'"
                    x-text="msg.text"
                  ></p>
                </div>
              </template>
            </div>

            <div class="p-3 shrink-0">
              <div
                class="ghost-btn flex items-center gap-2 px-3 py-1.5 rounded-full focus-ring"
              >
                <input
                  type="text"
                  x-model="chatReplyInput"
                  @keydown.enter="submitChatReply()"
                  placeholder="Reply..."
                  class="flex-1 bg-transparent border-none outline-none text-[14px] text-foreground"
                />
                <button
                  @click="submitChatReply()"
                  class="w-6 h-6 flex items-center justify-center rounded-full bg-foreground text-background hover:opacity-90"
                >
                  <iconify-icon :icon="getIconName('send')" class="w-3 h-3"></iconify-icon>
                </button>
              </div>
            </div>
          </div>
        </template>
      </div>
    </template>

    <template x-if="rightRailMode === 'properties'">
      <div class="flex-1 overflow-y-auto no-scrollbar">
        <template x-if="!activeEntry">
          <div class="px-5 py-6 text-[14px] text-muted-foreground">
            Select an entry to edit its properties.
          </div>
        </template>
        <template x-if="activeEntry">
          <div class="px-5 py-4 space-y-5">
            <div>
              <p class="text-[12px] font-medium text-muted-foreground mb-2">
                Status
              </p>
              <div class="flex flex-wrap gap-1.5">
                <template x-for="s in ['todo','doing','done','blocked','draft','published']" :key="s">
                  <button
                    @click="activeEntry.status = s"
                    :class="activeEntry.status === s ? 'bg-foreground text-background' : 'bg-secondary text-foreground hover:bg-hover'"
                    class="px-3 py-1 text-[12px] font-medium rounded-full capitalize"
                  >
                    <span x-text="s"></span>
                  </button>
                </template>
              </div>
            </div>

            <template x-if="activeEntry.priority">
              <div>
                <p class="text-[12px] font-medium text-muted-foreground mb-2">
                  Priority
                </p>
                <div class="flex flex-wrap gap-1.5">
                  <template x-for="p in ['high','medium','low']" :key="p">
                    <button
                      @click="activeEntry.priority = p"
                      :class="activeEntry.priority === p ? 'bg-foreground text-background' : 'bg-secondary text-foreground hover:bg-hover'"
                      class="px-3 py-1 text-[12px] font-medium rounded-full capitalize"
                    >
                      <span x-text="p"></span>
                    </button>
                  </template>
                </div>
              </div>
            </template>

            <template x-if="activeEntry.due">
              <div>
                <p class="text-[12px] font-medium text-muted-foreground mb-2">
                  Due
                </p>
                <input
                  type="date"
                  x-model="activeEntry.due"
                  class="w-full bg-secondary text-foreground text-[14px] px-3 py-1.5 rounded-full outline-none focus-ring"
                />
              </div>
            </template>

            <template x-if="activeEntry.start && activeEntry.end">
              <div>
                <p class="text-[12px] font-medium text-muted-foreground mb-2">
                  Timeline
                </p>
                <div class="flex items-center gap-2">
                  <input
                    type="date"
                    x-model="activeEntry.start"
                    class="flex-1 bg-secondary text-foreground text-[14px] px-3 py-1.5 rounded-full outline-none focus-ring"
                  />
                  <span class="text-muted-foreground">→</span>
                  <input
                    type="date"
                    x-model="activeEntry.end"
                    class="flex-1 bg-secondary text-foreground text-[14px] px-3 py-1.5 rounded-full outline-none focus-ring"
                  />
                </div>
              </div>
            </template>

            <template x-if="activeEntry.url">
              <div>
                <p class="text-[12px] font-medium text-muted-foreground mb-2">
                  URL
                </p>
                <input
                  type="text"
                  x-model="activeEntry.url"
                  class="w-full bg-secondary text-foreground text-[14px] px-3 py-1.5 rounded-full outline-none focus-ring"
                />
              </div>
            </template>

            <template x-if="activeEntry.assignee">
              <div>
                <p class="text-[12px] font-medium text-muted-foreground mb-2">
                  Assignee
                </p>
                <input
                  type="text"
                  x-model="activeEntry.assignee"
                  class="w-full bg-secondary text-foreground text-[14px] px-3 py-1.5 rounded-full outline-none focus-ring"
                />
              </div>
            </template>

            <template x-if="activeEntry.owner">
              <div>
                <p class="text-[12px] font-medium text-muted-foreground mb-2">
                  Owner
                </p>
                <input
                  type="text"
                  x-model="activeEntry.owner"
                  class="w-full bg-secondary text-foreground text-[14px] px-3 py-1.5 rounded-full outline-none focus-ring"
                />
              </div>
            </template>

            <template x-if="activeEntry.tags && activeEntry.tags.length > 0">
              <div>
                <p class="text-[12px] font-medium text-muted-foreground mb-2">
                  Tags
                </p>
                <div class="flex flex-wrap gap-1.5">
                  <template x-for="tag in activeEntry.tags" :key="tag">
                    <span class="tag-pill" x-text="`#${tag}`"></span>
                  </template>
                </div>
              </div>
            </template>
          </div>
        </template>
      </div>
    </template>
  </div>
</section>
