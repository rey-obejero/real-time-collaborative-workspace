<section
  :class="isConversationsPanelOpen ? 'w-80 shrink-0 flex' : 'w-0 shrink-0 hidden'"
  style="transition: width 0.25s ease"
>
  <div
    class="w-80 h-full flex flex-col border-l border-border bg-background overflow-hidden"
  >
    <div
      class="h-14 px-5 flex items-center justify-between shrink-0 border-b border-border"
    >
      <div class="flex items-center gap-2 text-[14px] font-semibold">
        <span>Conversations</span>
        <span
          class="text-muted-foreground font-mono"
          x-text="`(${discussions.length})`"
          >0</span
        >
      </div>
      <button
        @click="toggleConversations()"
        class="w-7 h-7 flex items-center justify-center rounded-full hover:bg-secondary focus-ring"
      >
        <svg
          class="w-3.5 h-3.5"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M6 18L18 6M6 6l12 12"
          />
        </svg>
      </button>
    </div>

    <template x-if="selectedDiscussionId === null">
      <div class="flex-1 overflow-y-auto no-scrollbar">
        <p
          class="text-[12px] font-medium px-5 py-3 text-muted-foreground"
        >
          Active
        </p>
        <ul class="px-2 space-y-0.5">
          <template x-for="chat in discussions" :key="chat.id">
            <li
              class="row-item cursor-pointer"
              @click="selectedDiscussionId = chat.id"
            >
              <div class="px-3 py-2.5">
                <div class="flex items-baseline justify-between mb-1">
                  <span
                    class="text-[14px] font-semibold leading-none text-foreground"
                    x-text="chat.title"
                  ></span>
                  <span class="status-dot"></span>
                </div>
                <p
                  class="text-[12px] truncate leading-relaxed text-muted-foreground"
                  x-text="chat.preview"
                ></p>
              </div>
            </li>
          </template>
        </ul>
      </div>
    </template>

    <template x-if="selectedDiscussionId !== null">
      <div class="flex-1 flex flex-col overflow-hidden">
        <div
          class="px-5 py-2 flex items-center gap-2 shrink-0 border-b border-border"
        >
          <button
            @click="selectedDiscussionId = null"
            class="w-7 h-7 flex items-center justify-center rounded-full hover:bg-secondary focus-ring"
          >
            <svg
              class="w-3.5 h-3.5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M15.75 19.5L8.25 12l7.5-7.5"
              />
            </svg>
          </button>
          <span
            class="text-[14px] font-semibold truncate"
            x-text="activeDiscussion ? activeDiscussion.title : ''"
          ></span>
        </div>

        <div
          id="messages-canvas"
          class="flex-1 overflow-y-auto no-scrollbar px-5 py-4 space-y-4"
        >
          <template
            x-for="(msg, idx) in (activeDiscussion ? activeDiscussion.messages : [])"
            :key="idx"
          >
            <div
              :class="msg.sender === 'Me' ? 'flex flex-col items-end' : 'space-y-1'"
            >
              <p
                class="text-[12px] font-medium mb-1 text-muted-foreground"
                x-text="msg.sender === 'Me' ? 'You' : msg.sender"
              ></p>
              <p
                class="text-[12px] leading-relaxed max-w-[85%]"
                :class="msg.sender === 'Me' ? 'px-3 py-1.5 rounded-full bg-foreground text-background' : 'text-foreground'"
                x-text="msg.text"
              ></p>
            </div>
          </template>
        </div>

        <div class="p-3 shrink-0 border-t border-border">
          <div
            class="ghost-btn flex items-center gap-2 px-3 py-1.5 rounded-full focus-ring"
          >
            <input
              type="text"
              x-model="chatReplyInput"
              @keydown.enter="submitChatReply()"
              placeholder="Reply..."
              class="flex-1 bg-transparent border-none outline-none text-[12px] text-foreground"
            />
            <button
              @click="submitChatReply()"
              class="w-6 h-6 flex items-center justify-center rounded-full bg-foreground text-background hover:opacity-90"
            >
              <svg
                class="w-3 h-3"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5"
                />
              </svg>
            </button>
          </div>
        </div>
      </div>
    </template>
  </div>
</section>
