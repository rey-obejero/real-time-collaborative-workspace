
<header
  class="h-14 px-6 grid grid-cols-[1fr_auto_1fr] items-center shrink-0 border-b border-border select-none"
>
  <div class="flex items-center gap-1.5">
    <button class="w-7 h-7 flex items-center justify-center rounded-[7px] hover:bg-hover cursor-pointer" title="Go back">
      <iconify-icon :icon="getIconName('back')" class="w-3.5 h-3.5"></iconify-icon>
    </button>
    <button class="w-7 h-7 flex items-center justify-center rounded-[7px] hover:bg-hover cursor-pointer" title="Go forward">
      <iconify-icon :icon="getIconName('next')" class="w-3.5 h-3.5"></iconify-icon>
    </button>
    <button class="w-7 h-7 flex items-center justify-center rounded-[7px] hover:bg-hover cursor-pointer" title="Recently opened">
      <iconify-icon :icon="getIconName('recent')" class="w-3.5 h-3.5"></iconify-icon>
    </button>
  </div>

  <div class="flex items-center justify-center text-[14px]">
    <iconify-icon :icon="getIconName(headerIcon)" class="w-3.5 h-3.5 text-muted-foreground mr-2"></iconify-icon>
    <span class="text-foreground font-medium" x-text="headerCrumb">All</span>
  </div>

  <div class="flex items-center justify-end gap-1.5">
    <button
      @click="isDarkMode = !isDarkMode"
      class="w-7 h-7 flex items-center justify-center rounded-[7px] hover:bg-hover cursor-pointer"
      title="Toggle theme"
    >
      <span x-show="!isDarkMode" class="inline-flex items-center w-3.5 h-3.5">
        <iconify-icon :icon="getIconName('moon')" class="w-full h-full"></iconify-icon>
      </span>
      <span x-show="isDarkMode" class="inline-flex items-center w-3.5 h-3.5">
        <iconify-icon :icon="getIconName('sun')" class="w-full h-full"></iconify-icon>
      </span>
    </button>
    <button class="w-7 h-7 flex items-center justify-center rounded-[7px] hover:bg-hover cursor-pointer" title="Pin to favorites">
      <iconify-icon :icon="getIconName('star')" class="w-3.5 h-3.5"></iconify-icon>
    </button>
    <button class="ask-ai-pill flex items-center h-7 gap-1.5 px-3 text-[14px] font-medium text-foreground rounded-[7px] cursor-pointer">
      <iconify-icon :icon="getIconName('ai')" class="w-3.5 h-3.5"></iconify-icon>
      <span>Ask AI</span>
    </button>
  </div>
</header>

