  <header
    class="h-14 px-6 grid grid-cols-[1fr_auto_1fr] items-center shrink-0 border-b border-border select-none"
  >
    <div class="flex items-center gap-1.5">
      <button class="header-btn relative w-7 h-7 flex items-center justify-center rounded-[7px] hover:bg-hover cursor-pointer" title="Go back">
        <iconify-icon :icon="getIconName('back')" class="w-3.5 h-3.5"></iconify-icon>
        <span class="header-tooltip">Back <kbd class="header-tooltip-kbd">Alt <iconify-icon :icon="getIconName('arrow-left')" class="w-3 h-3"></iconify-icon></kbd></span>
      </button>
      <button class="header-btn relative w-7 h-7 flex items-center justify-center rounded-[7px] hover:bg-hover cursor-pointer" title="Go forward">
        <iconify-icon :icon="getIconName('next')" class="w-3.5 h-3.5"></iconify-icon>
        <span class="header-tooltip">Forward <kbd class="header-tooltip-kbd">Alt <iconify-icon :icon="getIconName('arrow-right')" class="w-3 h-3"></iconify-icon></kbd></span>
      </button>
      <button class="header-btn relative w-7 h-7 flex items-center justify-center rounded-[7px] hover:bg-hover cursor-pointer" title="Recently opened">
        <iconify-icon :icon="getIconName('recent')" class="w-3.5 h-3.5"></iconify-icon>
        <span class="header-tooltip">Recents</span>
      </button>
    </div>

    <div class="relative">
      <button class="header-btn flex items-center gap-2 h-7 px-2 rounded-[7px] text-[14px] border border-transparent hover:border-border cursor-pointer" title="Copy link">
        <iconify-icon :icon="getIconName(headerIcon)" class="w-3.5 h-3.5 text-muted-foreground"></iconify-icon>
        <span class="text-foreground font-medium" x-text="headerCrumb">All</span>
        <span class="header-tooltip">Copy link</span>
      </button>
    </div>

    <div class="flex items-center justify-end gap-1.5">
      <button
        @click="isDarkMode = !isDarkMode"
        class="header-btn relative w-7 h-7 flex items-center justify-center rounded-[7px] hover:bg-hover cursor-pointer"
        title="Toggle theme"
      >
        <span x-show="!isDarkMode" class="inline-flex items-center w-3.5 h-3.5">
          <iconify-icon :icon="getIconName('moon')" class="w-full h-full"></iconify-icon>
        </span>
        <span x-show="isDarkMode" class="inline-flex items-center w-3.5 h-3.5">
          <iconify-icon :icon="getIconName('sun')" class="w-full h-full"></iconify-icon>
        </span>
        <span class="header-tooltip" x-text="isDarkMode ? 'Switch to light mode' : 'Switch to dark mode'">Switch to dark mode</span>
      </button>
      <button class="ask-ai-text flex items-center h-7 gap-1.5 px-2 text-[14px] font-medium text-foreground rounded-[7px] cursor-pointer">
        <iconify-icon :icon="getIconName('ai-fill')" class="w-3.5 h-3.5"></iconify-icon>
        <span>Ask AI</span>
      </button>
      <button class="header-btn flex items-center gap-1.5 h-7 px-2 text-[14px] font-medium text-foreground rounded-[7px] border border-border bg-transparent hover:bg-hover cursor-pointer" title="Share">
        <iconify-icon :icon="getIconName('share')" class="w-3.5 h-3.5"></iconify-icon>
        <span>Share</span>
      </button>
      <button class="header-btn relative w-8 h-8 flex items-center justify-center rounded-[7px] hover:bg-hover cursor-pointer" title="Menu">
        <iconify-icon :icon="getIconName('more-fill')" class="w-5 h-5"></iconify-icon>
        <span class="header-tooltip">Menu</span>
      </button>
    </div>
  </header>
