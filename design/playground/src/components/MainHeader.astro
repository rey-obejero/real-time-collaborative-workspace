<header
  class="h-14 px-6 flex items-center justify-between shrink-0 border-b border-border"
>
    <button
      @click="isDarkMode = !isDarkMode"
      class="w-7 h-7 flex items-center justify-center rounded-full hover:bg-accent focus-ring"
      title="Toggle theme"
    >
      <svg
        x-show="!isDarkMode"
        class="w-3.5 h-3.5"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z"
        />
      </svg>
      <svg
        x-show="isDarkMode"
        class="w-3.5 h-3.5"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M12 3v2.25m0 13.5V21m-7.5-9h2.25m13.5 0H21m-3.75-5.25l1.59-1.59M5.81 18.19l-1.59 1.59m0-13.5l1.59 1.59m11.38 11.38l1.59 1.59M12 7.5a4.5 4.5 0 100 9 4.5 4.5 0 000-9z"
        />
      </svg>
    </button>

  <div class="flex items-center gap-1.5 text-[14px] text-muted-foreground">
    <span class="text-foreground font-medium" x-text="headerCrumb">All</span>
  </div>

  <div class="flex items-center gap-2">
    <button
      @click="toggleConversations()"
      class="w-7 h-7 flex items-center justify-center rounded-full hover:bg-secondary focus-ring relative"
      title="Discussions"
    >
      <svg
        class="w-3.5 h-3.5"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.12 2.9 2.78 2.9h12.94c1.66 0 2.78-1.3 2.78-2.9V6.4c0-1.6-1.12-2.9-2.78-2.9H5.53c-1.66 0-2.78 1.3-2.78 2.9v10.32z"
        />
      </svg>
      <span
        x-show="hasUnreadDiscussions"
        class="absolute top-1 right-1 status-dot"
      ></span>
    </button>
    <button
      class="ask-ai-pill flex items-center gap-1.5 px-2.5 py-1 text-[14px] font-medium"
    >
      <svg
        class="w-3 h-3"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 00-2.456 2.456zM16.894 20.567L16.5 21.75l-.394-1.183a2.25 2.25 0 00-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 001.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 001.423 1.423l1.183.394-1.183.394a2.25 2.25 0 00-1.423 1.423z"
        />
      </svg>
      <span>Ask AI</span>
    </button>
  </div>
</header>
