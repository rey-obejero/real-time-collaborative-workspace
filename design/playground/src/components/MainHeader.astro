
<header
  class="h-14 px-6 flex items-center justify-between shrink-0 border-b border-border select-none"
>
  <div class="flex items-center gap-1.5 text-[14px] text-muted-foreground">
    <span class="text-foreground font-medium" x-text="headerCrumb">All</span>
  </div>

  <div class="flex items-center gap-2">
    <button
      @click="isDarkMode = !isDarkMode"
      class="w-7 h-7 flex items-center justify-center rounded-full hover:bg-accent focus-ring"
      title="Toggle theme"
    >
      <span x-show="!isDarkMode" class="inline-flex items-center w-3.5 h-3.5">
        <iconify-icon :icon="getIconName('moon')" class="w-full h-full"></iconify-icon>
      </span>
      <span x-show="isDarkMode" class="inline-flex items-center w-3.5 h-3.5">
        <iconify-icon :icon="getIconName('sun')" class="w-full h-full"></iconify-icon>
      </span>
    </button>
    <button
      class="ask-ai-pill flex items-center gap-1.5 px-4 py-1.5 text-[14px] font-medium"
    >
      <iconify-icon :icon="getIconName('sparkles')" class="w-3.5 h-3.5"></iconify-icon>
      <span>Ask AI</span>
    </button>

  </div>
</header>

